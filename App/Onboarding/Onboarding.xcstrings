        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "示意圖：點選單列上的 MacHelper 項目，會打開顯示即時數值的面板。"
          }
        }
      }
    },
    "In General → Login Items & Extensions, turn on MacHelper under “Allow in the Background”.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En General → Ítems de inicio y extensiones, activa MacHelper en “Permitir en segundo plano”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「一般」→「ログイン項目と機能拡張」の「バックグラウンドでの実行を許可」で MacHelper をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 → 로그인 항목 및 확장 프로그램의 ‘백그라운드에서 허용’에서 MacHelper를 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“通用”→“登录项与扩展”的“允许在后台”下打开 MacHelper。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「一般」→「登入項目與延伸功能」的「允許在背景執行」底下打開 MacHelper。"
          }
        }
      }
    },
