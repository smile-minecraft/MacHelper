    "Click for the quick panel": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para el panel rápido"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックでクイックパネル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 빠른 패널"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下打开快速面板"
