    "Here’s how MacHelper is set up. Click any item to change it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así ha quedado MacHelper. Haz clic en cualquier elemento para cambiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacHelper の現在の設定です。項目をクリックすると変更できます。"
          }
