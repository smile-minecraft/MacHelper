        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下開啟快速面板"
          }
        }
      }
    },
    "Close the guide. You can open it again from Help → Welcome Guide.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la guía. Puedes volver a abrirla desde Ayuda → Guía de bienvenida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイドを閉じます。「ヘルプ」→「ようこそガイド」からいつでも開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드를 닫습니다. 도움말 → 환영 가이드에서 다시 열 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭导览。之后可以从“帮助”→“欢迎导览”再次打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉導覽。之後可以從「輔助說明」→「歡迎導覽」再次開啟。"
          }
        }
      }
    },
    "Close the window, keep the help": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la ventana, la ayuda sigue ahí"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じても動き続けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 닫아도 계속 도와줍니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉窗口，帮手还在"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關掉視窗，幫手還在"
          }
        }
      }
    },
    "CPU, GPU, memory, SSD, network, battery and power, each on its own tab.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, GPU, memoria, SSD, red, batería y consumo, cada uno en su pestaña."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、GPU、メモリ、SSD、ネットワーク、バッテリー、電力をそれぞれのタブで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, GPU, 메모리, SSD, 네트워크, 배터리, 전력이 각각 탭으로 나뉩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、GPU、内存、SSD、网络、电池和功耗，各有自己的标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、GPU、記憶體、SSD、網路、電池和功耗，各有自己的分頁。"
          }
        }
      }
    },
    "CPU, GPU, memory, temperatures and power, live in the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, GPU, memoria, temperaturas y consumo, en vivo en la barra de menús."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、GPU、メモリ、温度、電力をメニューバーでリアルタイムに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, GPU, 메모리, 온도, 전력을 메뉴 막대에서 실시간으로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、GPU、内存、温度和功耗，实时显示在菜单栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、GPU、記憶體、溫度和功耗，即時顯示在選單列。"
          }
        }
      }
    },
