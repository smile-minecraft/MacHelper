    "Illustration: the MacHelper item in the menu bar opens a panel with live readings.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilustración: el elemento de MacHelper en la barra de menús abre un panel con lecturas en vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イラスト：メニューバーの MacHelper 項目をクリックすると、リアルタイムの値を表示するパネルが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 메뉴 막대의 MacHelper 항목을 클릭하면 실시간 수치 패널이 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示意图：点菜单栏上的 MacHelper 项目，会打开显示实时数值的面板。"
          }
