    },
    "No capacity history yet": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay historial de capacidad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量の履歴はまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 용량 기록이 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有容量记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有容量紀錄"
          }
        }
      }
    },
    "Capacity is recorded once an hour. This chart fills in after MacHelper has been running for a while.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La capacidad se registra una vez por hora. Este gráfico se completará cuando MacHelper lleve un tiempo en ejecución."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量は1時間に1回記録されます。MacHelper がしばらく動作すると、このグラフに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량은 한 시간에 한 번 기록됩니다. MacHelper가 잠시 실행되면 이 차트가 채워집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容量每小时记录一次。MacHelper 运行一段时间后，此图表会逐渐显示记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "容量每小時記錄一次。MacHelper 執行一段時間後，圖表會逐漸顯示紀錄。"
          }
        }
      }
    },
    "One reading so far": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lectura hasta ahora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでに1件の記録"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 기록 1개"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有一笔记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有一筆紀錄"
          }
        }
      }
    },
    "The line appears after the next hourly reading.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea aparecerá con la próxima lectura horaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の1時間ごとの記録で線が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 정시 기록이 저장되면 선이 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次每小时记录后会显示连线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次每小時記錄後會顯示連線。"
          }
        }
      }
    },
