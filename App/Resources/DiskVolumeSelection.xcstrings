    "Capacity unavailable": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacidad no disponible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量を取得できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량을 사용할 수 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容量不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "容量無法取得"
          }
        }
      }
    },
    "macOS didn’t report the capacity of this disk.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no informó de la capacidad de este disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がこのディスクの容量を報告しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 이 디스크의 용량을 보고하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 没有报告此磁盘的容量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 沒有回報此磁碟的容量。"
          }
        }
      }
    },
    "This disk can’t be identified": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede identificar este disco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクを識別できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스크를 식별할 수 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别此磁盘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法辨識此磁碟"
          }
        }
      }
    },
    "macOS didn’t report a stable identity for this disk, so its capacity history can’t be read.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no informó de una identidad estable para este disco, por lo que no se puede leer su historial de capacidad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がこのディスクの安定した識別子を報告しなかったため、容量の履歴を読み取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 이 디스크의 안정적인 식별자를 보고하지 않아 용량 기록을 읽을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 没有报告此磁盘的稳定标识，因此无法读取其容量记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 沒有回報此磁碟的穩定識別，因此無法讀取它的容量紀錄。"
          }
        }
      }
    },
    "This disk is no longer mounted": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco ya no está montado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクはマウントされていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스크는 더 이상 마운트되지 않음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁盘已不再挂载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁碟已不再掛載"
          }
        }
      }
    },
    "%@ is no longer mounted. Its capacity is not shown instead of switching to another disk.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya no está montado. No se muestra su capacidad en lugar de cambiar a otro disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はマウントされていません。別のディスクに切り替えず、容量を表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 더 이상 마운트되지 않았습니다. 다른 디스크로 전환하지 않고 용량을 표시하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不再挂载。这里不会改显示其他磁盘，而是不显示容量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不再掛載。這裡不會改顯示其他磁碟，而是不顯示容量。"
          }
        }
      }
    },
    "This disk shares free space with other APFS volumes": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco comparte espacio libre con otros volúmenes APFS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクは他の APFS ボリュームと空き容量を共有しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스크는 다른 APFS 볼륨과 여유 공간을 공유합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁盘与其他 APFS 宗卷共用可用空间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁碟與其他 APFS 卷宗共用可用空間"
          }
        }
      }
    },
    "APFS volumes in the same container draw from one free-space pool. This capacity is not separate space you can add to another disk.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los volúmenes APFS del mismo contenedor usan un único espacio libre. Esta capacidad no es espacio independiente que puedas sumar al de otro disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じコンテナ内の APFS ボリュームは 1 つの空き容量プールを共有します。この容量は、別のディスクに足せる独立した領域ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 컨테이너의 APFS 볼륨은 하나의 여유 공간 풀을 공유합니다. 이 용량은 다른 디스크에 더할 수 있는 별도 공간이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一容器内的 APFS 宗卷共用同一个可用空间池。此容量不是可以加到其他磁盘上的独立空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一容器內的 APFS 卷宗共用同一個可用空間池。此容量不是可以加到其他磁碟上的獨立空間。"
          }
        }
      }
    },
    "Activity (all disks)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad (todos los discos)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティ（すべてのディスク）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동(모든 디스크)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动（所有磁盘）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "活動（所有磁碟）"
          }
        }
      }
    },
    "Read and write rates cover every disk in this Mac, not only the selected disk.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las velocidades de lectura y escritura abarcan todos los discos de este Mac, no solo el disco seleccionado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取りと書き込みの速度は、選択したディスクだけでなく、この Mac のすべてのディスクが対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 및 쓰기 속도는 선택한 디스크뿐 아니라 이 Mac의 모든 디스크를 포함합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读写速度涵盖这台 Mac 上的所有磁盘，不只是所选磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀寫速度涵蓋這台 Mac 上的所有磁碟，不只是所選磁碟。"
          }
        }
      }
    },
    "Loading capacity history…": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando historial de capacidad…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量の履歴を読み込み中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 기록을 불러오는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载容量记录…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在載入容量紀錄…"
          }
        }
      }
    },
    "Couldn’t read capacity history: %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el historial de capacidad: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量の履歴を読み取れませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 기록을 읽지 못했습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取容量记录：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取容量紀錄：%@"
          }
        }
      }
    },
    "Capacity history isn’t available because this disk has no stable identity.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de capacidad no está disponible porque este disco no tiene una identidad estable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクには安定した識別子がないため、容量の履歴を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스크에 안정적인 식별자가 없어 용량 기록을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁盘没有稳定标识，因此无法使用容量记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁碟沒有穩定識別，因此無法使用容量紀錄。"
          }
        }
      }
    },
    "Capacity history isn’t available because this disk is not mounted.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de capacidad no está disponible porque este disco no está montado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクがマウントされていないため、容量の履歴を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스크가 마운트되지 않아 용량 기록을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁盘未挂载，因此无法使用容量记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁碟未掛載，因此無法使用容量紀錄。"
          }
        }
      }
    },
    "Capacity history isn’t available because the history database couldn’t be opened.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de capacidad no está disponible porque no se pudo abrir la base de datos del historial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴データベースを開けなかったため、容量の履歴を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 데이터베이스를 열지 못해 용량 기록을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开历史数据库，因此无法使用容量记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟歷史資料庫，因此無法使用容量紀錄。"
          }
        }
      }
    },
    "Capacity is recorded once an hour while MacHelper is running. If background recording is off, recording stops when MacHelper quits.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La capacidad se registra una vez por hora mientras MacHelper está en ejecución. Si la grabación en segundo plano está desactivada, el registro se detiene al cerrar MacHelper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量は MacHelper の実行中に 1 時間に 1 回記録されます。バックグラウンド記録がオフの場合、MacHelper を終了すると記録は停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량은 MacHelper가 실행되는 동안 한 시간에 한 번 기록됩니다. 백그라운드 기록이 꺼져 있으면 MacHelper를 종료할 때 기록이 중지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacHelper 运行期间每小时记录一次容量。如果未启用后台记录，退出 MacHelper 后就不再记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacHelper 執行期間每小時記錄一次容量。如果未啟用背景記錄，結束 MacHelper 後就不再記錄。"
          }
        }
      }
    },
    "This permanently deletes all per-minute monitoring history, every metric it contains, and the hourly free-space history for every recorded disk. It can’t be undone. Process usage history, sensor and core history, other settings, and the operation history are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todo el historial de monitorización por minuto, todas las métricas que contiene y el historial horario de espacio libre de todos los discos registrados. No se puede deshacer. El historial de uso de procesos, el historial de sensores y núcleos, los demás ajustes y el historial de operaciones no se ven afectados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分ごとの監視履歴とそのすべての指標、および記録済みのすべてのディスクの 1 時間ごとの空き容量履歴を完全に削除します。元に戻せません。プロセスの使用履歴、センサーとコアの履歴、その他の設定、操作履歴は影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분 단위 모니터링 기록과 그 안의 모든 지표, 기록된 모든 디스크의 시간별 여유 공간 기록을 영구적으로 삭제합니다. 되돌릴 수 없습니다. 프로세스 사용 기록, 센서 및 코어 기록, 기타 설정, 작업 기록은 영향을 받지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除所有每分钟监控记录及其中的每项指标，以及所有已记录磁盘的每小时可用空间记录。无法撤销。进程使用记录、传感器与核心记录、其他设置和操作记录不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除所有每分鐘監控紀錄及其中的每項指標，以及所有已記錄磁碟的每小時可用空間紀錄。無法復原。程序使用紀錄、感測器與核心紀錄、其他設定和操作紀錄不受影響。"
          }
        }
      }
    },
