            "state": "translated",
            "value": "正在檢查磁碟…"
          }
        }
      }
    },
    "Couldn’t read the disk list: %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la lista de discos: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの一覧を読み取れませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 목록을 읽지 못했습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取磁盘列表：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取磁碟列表：%@"
          }
        }
      }
