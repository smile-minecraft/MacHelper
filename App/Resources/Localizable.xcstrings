    "Shares storage with another copy; deleting it alone frees almost nothing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte almacenamiento con otra copia; eliminar solo esta casi no libera espacio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のコピーと容量を共有しています。これだけを削除してもほとんど空きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사본과 저장 공간을 공유합니다. 이것만 삭제하면 거의 확보되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与另一个副本共享存储空间，单独删除它几乎不会释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與另一份共用儲存空間，單獨刪除它幾乎不會釋放空間。"
          }
        }
      }
    },
