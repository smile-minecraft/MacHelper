    "Open now, will be quit and reopened: %@. Save your work in them first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Están abiertas y se cerrarán y volverán a abrir: %@. Guarda antes tu trabajo en ellas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているため、終了してから再び開きます: %@。先に作業内容を保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열려 있어 종료했다가 다시 엽니다: %@. 먼저 작업 내용을 저장하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下 App 正在运行，会先退出再重新打开：%@。请先保存其中的工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下 App 正開著，會先結束再重新打開：%@。請先儲存其中的工作。"
          }
        }
      }
    },
    "%@ didn’t quit. Quit it yourself and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se cerró. Ciérrala tú y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が終了しませんでした。自分で終了してからもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 종료되지 않았습니다. 직접 종료한 다음 다시 시도하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有退出。请自行退出后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有結束。請自行結束後再試一次。"
          }
        }
      }
    },
