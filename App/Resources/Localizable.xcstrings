    "Cleaned items go to the Trash; the space is freed once you empty it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos limpiados van a la Papelera; el espacio se libera al vaciarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンした項目はゴミ箱に入ります。ゴミ箱を空にすると容量が解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리한 항목은 휴지통으로 이동합니다. 휴지통을 비우면 공간이 확보됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理的项目会移到废纸篓，清空废纸篓后才会真正释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清掉的項目會移到垃圾桶，要清空垃圾桶後才會真正釋放空間。"
          }
        }
      }
    },
