    "All operations are logged in ~/Library/Logs/MacHelper/operations.jsonl": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las operaciones se registran en ~/Library/Logs/MacHelper/operations.jsonl"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての操作は ~/Library/Logs/MacHelper/operations.jsonl に記録されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 작업은 ~/Library/Logs/MacHelper/operations.jsonl에 기록됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
