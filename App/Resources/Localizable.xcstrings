          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受 macOS 保護"
          }
        }
      }
    },
    "System Integrity Protection, data vaults, and folders that belong to the system or another user account. Full Disk Access doesn’t open them to any app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protección de la integridad del sistema, bóvedas de datos y carpetas que pertenecen al sistema o a otra cuenta de usuario. El acceso total al disco no las abre a ninguna app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム整合性保護、データ保管庫、システムや別のユーザアカウントに属するフォルダです。フルディスクアクセスがあっても、どの App にも開放されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 무결성 보호, 데이터 보관소, 시스템이나 다른 사용자 계정에 속한 폴더입니다. 전체 디스크 접근 권한이 있어도 어떤 앱에도 열리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统完整性保护、数据保险库，以及属于系统或其他用户账户的文件夹。完全磁盘访问权限也不会让任何 App 读取它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統完整性保護、資料保險庫，以及屬於系統或其他使用者帳號的資料夾。完全取用磁碟權限也不會讓任何 App 讀取它們。"
          }
        }
      }
    },
