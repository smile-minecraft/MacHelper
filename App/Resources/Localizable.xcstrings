      }
    },
    "Will replace": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazará"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将被替换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將被取代"
          }
        }
      }
    },
    "The cleaning whitelist and extra purge folders are replaced as a whole list. Comments and blank lines in the current text files aren’t kept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de exclusiones de limpieza y las carpetas adicionales de purga se reemplazan como lista completa. No se conservan los comentarios ni las líneas en blanco de los archivos de texto actuales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーン除外リストと追加の削除対象フォルダは、リスト全体が置き換えられます。現在のテキストファイルのコメントと空行は残りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 제외 목록과 추가 정리 폴더는 목록 전체가 대체됩니다. 현재 텍스트 파일의 주석과 빈 줄은 유지되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理白名单与额外清除文件夹会整体替换。当前文本文件中的注释与空行不会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理白名單與額外清除資料夾會整份取代。目前文字檔中的註解與空行不會保留。"
          }
        }
      }
    },
    "The rules file contains duplicate rule ids.": {
      "localizations": {
        "es": {
          "stringUnit": {
