          }
        }
      }
    },
    "Sunburst": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旭日圖"
          }
        }
      }
    },
    "Sunburst: %@, %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旭日圖：%@，%@"
          }
        }
      }
    },
    "Swap": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap"
          }
        }
      }
    },
    "Switch profiles automatically": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動切換設定檔"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整機"
          }
        }
      }
    },
    "System (kernel)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統"
          }
        }
      }
    },
    "System Default": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統預設"
          }
        }
      }
    },
    "System control": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統控制"
          }
        }
      }
    },
    "System control (target %lld)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統控制（目標 %lld）"
          }
        }
      }
    },
    "Temperature": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度"
          }
        }
      }
    },
    "Temperature Curve": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度曲線"
          }
        }
      }
    },
    "Temperature exceeded the safety limit; control was handed back to the system": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度超過安全上限，已暫時交還系統控制"
          }
        }
      }
    },
    "Temperature source": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度來源"
          }
        }
      }
    },
    "Temperatures, memory and disk space are all in a healthy range.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度、記憶體與磁碟空間都在健康範圍內。"
          }
        }
      }
    },
    "The %lld selected items (%@) will be moved to the Trash, where you can get them back. App Store apps may ask for an administrator password.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選的 %lld 個項目（%@）會移到垃圾桶，需要時可以拿回來。App Store 的 App 可能會要求輸入管理員密碼。"
          }
        }
      }
    },
    "The background schedule needs your approval in Login Items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景排程需要你在「登入項目」允許。"
          }
        }
      }
    },
    "The firmware doesn’t seem to apply the Helper’s speed. On some models manual control only takes effect after the system has started the fans.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "韌體似乎沒有套用 Helper 的轉速。部分機型要等系統先啟動風扇後，手動控制才會生效。"
          }
        }
      }
    },
    "The first matching rule wins. When none matches, the setting you applied above is used.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由上往下，第一條符合的規則生效；都不符合時，使用你在上方套用的設定。"
          }
        }
      }
    },
    "The job is stopped and its plist goes to the Trash. The app that installed it may add it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會停止這個項目，並把它的 plist 移到垃圾桶。安裝它的 App 之後可能會再加回來。"
          }
        }
      }
    },
    "The macOS firmware controls the fans based on temperature. This is the safest setting.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 macOS 韌體依溫度自行控制風扇。這是最安全的設定。"
          }
        }
      }
    },
    "The new language is used after MacHelper relaunches.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動 MacHelper 後套用新的語言。"
          }
        }
      }
    },
    "The saved scan could not be cleared: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法清除已儲存的掃描：%@"
          }
        }
      }
    },
    "These items are named after a bundle ID whose app can no longer be found; for background items, the program they start no longer exists. This is a guess: review each item before checking it. Nothing is checked by default.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些項目以 bundle ID 命名，但對應的 App 已經找不到；背景啟動項目則是它要啟動的程式已不存在。這是推測，請逐項確認後再勾選，預設全部不勾。"
          }
        }
      }
    },
    "Things still run fine, but swapping may start soon.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還順，但可能很快會開始使用置換空間。"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac"
          }
        }
      }
    },
    "This result may be out of date. Scan again to update it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份結果可能已過時，請重新掃描以更新。"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間"
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        }
      }
    },
    "Top processes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高佔用程序"
          }
        }
      }
    },
    "Top processes by CPU": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最耗 CPU 的程序"
          }
        }
      }
    },
    "Top processes by memory": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最耗記憶體的程序"
          }
        }
      }
    },
    "Total": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總計"
          }
        }
      }
    },
    "Trash": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶"
          }
        }
      }
    },
    "Treemap": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "矩形樹狀圖"
          }
        }
      }
    },
    "Treemap: %@, click a block to open it": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "矩形樹狀圖：%@，點一下區塊進入"
          }
        }
      }
    },
    "Turn on at least one metric in Settings → Menu Bar to record its history. Process usage history has its own switch in Settings → General → Data management.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」→「選單列」開啟至少一個指標，才會記錄它的歷史。程序用量歷史有自己的開關，位於「設定」→「一般」→「資料管理」。"
          }
        }
      }
    },
    "Unchanged for %lld days": {
