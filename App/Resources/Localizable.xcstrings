    "Nothing in this file will replace a setting on this Mac. No changes will be made.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de este archivo reemplazará un ajuste de este Mac. No se harán cambios."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには、この Mac の設定を置き換えるものはありません。変更は行われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에는 이 Mac의 설정을 대체할 항목이 없습니다. 아무것도 변경되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件中没有会替换本机设置的内容，不会进行任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案沒有可取代的設定，不會變更任何內容。"
          }
        }
      }
    },
    "Optimize Scan Folders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas que escanea Optimizar"
          }
        },
        "ja": {
