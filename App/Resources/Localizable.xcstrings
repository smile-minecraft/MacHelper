          }
        }
      }
    },
    "This result may be out of date. Scan again to update it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este resultado puede estar desactualizado. Vuelve a escanear para actualizarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この結果は古い可能性があります。もう一度スキャンして更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결과는 오래되었을 수 있습니다. 다시 스캔하여 업데이트하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份结果可能已过时，请重新扫描以更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份結果可能已過時，請重新掃描以更新。"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "es": {
