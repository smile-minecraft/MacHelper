    "Scanning did not run because macOS would not stop automatic downloads of cloud-only files.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo no se ejecutó porque macOS no detuvo la descarga automática de archivos solo en la nube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がクラウドのみのファイルの自動ダウンロードを止められなかったため、スキャンは実行しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 클라우드 전용 파일의 자동 다운로드를 멈추지 않아 스캔을 실행하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描没有运行，因为 macOS 无法停止自动下载仅限云端的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描沒有執行，因為 macOS 無法停止自動下載僅限雲端的檔案。"
          }
        }
      }
    },
