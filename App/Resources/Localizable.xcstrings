            "value": "啟動項目"
          }
        }
      }
    },
    "Startup disk is almost full": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動磁碟快滿了"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "zh-Hant": {
