    },
    "The cooldown must be a positive number.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La espera debe ser un número positivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔は正の数にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 시간은 양수여야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知冷却时间必须是正数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知冷卻時間必須是正數。"
          }
        }
      }
    },
    "The current value is invalid: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor actual no es válido: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の値が無効です: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 값이 유효하지 않음: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前的值无效：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的值無效：%@"
          }
        }
      }
    },
    "The disk threshold must be between 5 and 200 GB.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El umbral de disco debe estar entre 5 y 200 GB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクのしきい値は 5〜200 GB にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 임계값은 5~200 GB 사이여야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘阈值必须在 5 到 200 GB 之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "磁碟門檻必須介於 5 到 200 GB。"
          }
        }
      }
    },
    "The file contains an unknown menu bar module.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo contiene un módulo de barra de menús desconocido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに不明なメニューバーモジュールが含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 알 수 없는 메뉴 막대 모듈이 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件含有未知的菜单栏模块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案含有未知的選單列模組。"
          }
        }
      }
    },
    "The menu bar interval must be 1, 2, 5, 10, or 30 seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intervalo de la barra de menús debe ser 1, 2, 5, 10 o 30 segundos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの間隔は 1、2、5、10、30 秒のいずれかにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 간격은 1, 2, 5, 10, 30초 중 하나여야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏更新间隔必须是 1、2、5、10 或 30 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列更新間隔必須是 1、2、5、10 或 30 秒。"
          }
        }
      }
    },
    "The temperature threshold must be between 70 and 105 °C.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El umbral de temperatura debe estar entre 70 y 105 °C."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度のしきい値は 70〜105 °C にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도 임계값은 70~105 °C 사이여야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度阈值必须在 70 到 105 °C 之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度門檻必須介於 70 到 105 °C。"
          }
        }
      }
    },
    "These categories could not be restored: %@.": {
