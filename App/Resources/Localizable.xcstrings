    "Runs MacHelper’s health check on the recorded history and returns the findings as text.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta la revisión de estado de MacHelper sobre el historial registrado y devuelve los resultados como texto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された履歴に対して MacHelper のヘルスチェックを実行し、結果をテキストで返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 기록으로 MacHelper 상태 점검을 실행하고 결과를 텍스트로 반환합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据已记录的历史运行 MacHelper 健康检查，并以文本返回结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據已記錄的歷史執行 MacHelper 健康檢查，並以文字回傳結果。"
          }
        }
      }
    },
