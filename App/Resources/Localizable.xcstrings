    "Never Clean": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No limpiar nunca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンしない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 안 함"
