    "Scan stopped before any results were ready.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo se detuvo antes de tener resultados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が出る前にスキャンを停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 나오기 전에 스캔이 중지되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描在产生任何结果前就停止了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描在產生任何結果前就停止了。"
          }
        }
      }
    },
    "Allow Full Disk Access to see everything": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso total al disco para verlo todo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを見るにはフルディスクアクセスを許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목을 보려면 전체 디스크 접근 권한을 허용하십시오"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
