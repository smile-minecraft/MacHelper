            "value": "移除控制點"
          }
        }
      }
    },
    "Removed %lld items; %lld not processed: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %lld 項，%lld 項未處理：%@"
