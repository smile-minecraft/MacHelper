    "Settings files never include monitoring history, scan caches, operation logs, or background recording.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔不含監控歷史、掃描快取、操作紀錄或背景記錄。"
