    "%lld places can’t be checked without Full Disk Access. MacHelper scans again once it’s on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lugares no se pueden revisar sin acceso total al disco. MacHelper vuelve a escanear cuando lo actives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld か所はフルディスクアクセスがないと確認できません。オンにすると MacHelper がもう一度スキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld곳은 전체 디스크 접근 권한 없이 확인할 수 없습니다. 권한을 켜면 MacHelper가 다시 스캔합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个位置需要「完全磁盘访问权限」才能检查。打开后 MacHelper 会自动重新扫描。"
          }
        },
        "zh-Hant": {
