          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双行显示（名称在上、数值在下，更省空间）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙行顯示（名稱在上、數值在下，比較省空間）"
          }
        }
      }
    },
