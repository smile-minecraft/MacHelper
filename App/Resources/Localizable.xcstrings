    "Want charts, fan control and startup items? Switch to Advanced in Settings → Appearance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres gráficos, control de ventiladores e ítems de arranque? Cambia a Avanzado en Ajustes → Apariencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフ、ファン制御、起動項目を使いたい場合は、「設定」→「外観」で「詳細」に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차트, 팬 제어, 시동 항목이 필요하다면 설정 → 모양에서 고급으로 전환하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要图表、风扇控制和启动项吗？到「设置 → 外观」切换成高级模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要圖表、風扇控制和啟動項目嗎？到「設定 → 外觀」切換成進階模式。"
          }
        }
      }
    },
