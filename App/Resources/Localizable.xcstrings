        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统控制（目标 %lld）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統控制（目標 %lld）"
          }
        }
      }
    },
    "Temperature": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度"
          }
        }
      }
    },
    "Temperature Curve": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva de temperatura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度カーブ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도 곡선"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度曲线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度曲線"
          }
        }
      }
    },
    "Temperature exceeded the safety limit; control was handed back to the system": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La temperatura superó el límite de seguridad; el control volvió al sistema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度が安全上限を超えたため、制御をシステムに戻しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도가 안전 한도를 넘어 시스템에 제어를 돌려주었습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度超过安全上限，已交还系统控制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度超過安全上限，已暫時交還系統控制"
          }
        }
      }
    },
    "Temperature source": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente de temperatura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度の基準"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도 기준"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度来源"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度來源"
          }
        }
      }
    },
    "Temperatures, memory and disk space are all in a healthy range.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La temperatura, la memoria y el espacio en disco están en un rango saludable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度、メモリ、ディスク容量はすべて正常な範囲です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도, 메모리, 디스크 공간이 모두 정상 범위입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度、内存与磁盘空间都在健康范围内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度、記憶體與磁碟空間都在健康範圍內。"
          }
        }
      }
    },
    "The %lld selected items (%@) will be moved to the Trash, where you can get them back. App Store apps may ask for an administrator password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld elementos seleccionados (%@) irán a la Papelera, donde podrás recuperarlos. Las apps de la App Store pueden pedir una contraseña de administrador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した %lld 項目（%@）はゴミ箱に入り、そこから戻せます。App Store の App では管理者パスワードを求められることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목 %lld개(%@)는 휴지통으로 이동하며 다시 꺼낼 수 있습니다. App Store 앱은 관리자 암호를 요구할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选的 %lld 个项目（%@）会移到废纸篓，需要时可以拿回来。App Store 的 App 可能会要求输入管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選的 %lld 個項目（%@）會移到垃圾桶，需要時可以拿回來。App Store 的 App 可能會要求輸入管理員密碼。"
          }
        }
      }
    },
    "The background schedule needs your approval in Login Items.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La programación en segundo plano necesita tu aprobación en Ítems de inicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドのスケジュールには「ログイン項目」での許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 일정은 로그인 항목에서 승인해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台调度需要你在「登录项」允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景排程需要你在「登入項目」允許。"
          }
        }
      }
    },
    "The firmware doesn’t seem to apply the Helper’s speed. On some models manual control only takes effect after the system has started the fans.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que el firmware no aplica la velocidad del Helper. En algunos modelos el control manual solo funciona después de que el sistema haya arrancado los ventiladores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファームウェアが Helper の速度を反映していないようです。機種によっては、システムがファンを回し始めてからでないと手動制御が効きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펌웨어가 Helper의 속도를 적용하지 않는 것 같습니다. 일부 모델에서는 시스템이 팬을 돌리기 시작한 후에만 수동 제어가 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固件似乎没有应用 Helper 的转速。部分机型要等系统先启动风扇后，手动控制才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "韌體似乎沒有套用 Helper 的轉速。部分機型要等系統先啟動風扇後，手動控制才會生效。"
          }
        }
      }
    },
    "The first matching rule wins. When none matches, the setting you applied above is used.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana la primera regla que coincida. Si ninguna coincide, se usa el ajuste que aplicaste arriba."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に一致したルールが使われます。どれにも一致しないときは、上で適用した設定を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 일치하는 규칙이 적용됩니다. 일치하는 규칙이 없으면 위에서 적용한 설정을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上到下，第一条匹配的规则生效；都不匹配时，使用你在上方应用的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由上往下，第一條符合的規則生效；都不符合時，使用你在上方套用的設定。"
          }
        }
      }
    },
    "The job is stopped and its plist goes to the Trash. The app that installed it may add it again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detiene el trabajo y su plist va a la Papelera. La app que lo instaló puede volver a añadirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジョブを停止し、その plist をゴミ箱に入れます。インストールした App がまた追加することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 중지하고 해당 plist를 휴지통으로 옮깁니다. 설치한 앱이 다시 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会停止这个项目，并把它的 plist 移到废纸篓。安装它的 App 之后可能会再加回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會停止這個項目，並把它的 plist 移到垃圾桶。安裝它的 App 之後可能會再加回來。"
          }
        }
      }
    },
    "The macOS firmware controls the fans based on temperature.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware de macOS controla los ventiladores según la temperatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のファームウェアが温度に応じてファンを制御します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 펌웨어가 온도에 따라 팬을 제어합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 macOS 固件根据温度自动控制风扇。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 macOS 韌體依溫度自行控制風扇。"
          }
        }
      }
    },
    "The new language is used after MacHelper relaunches.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma se usa cuando MacHelper se reinicia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語は MacHelper を再起動すると使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어는 MacHelper를 다시 실행한 후 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开 MacHelper 后使用新的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動 MacHelper 後套用新的語言。"
          }
        }
      }
    },
    "The saved scan could not be cleared: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo borrar el escaneo guardado: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したスキャンを消去できませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 스캔을 지울 수 없음: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法清除已保存的扫描：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法清除已儲存的掃描：%@"
          }
        }
      }
    },
    "These items are named after a bundle ID whose app can no longer be found; for background items, the program they start no longer exists. Nothing is checked by default.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos llevan el nombre de un ID de paquete cuya app ya no se encuentra; en los ítems en segundo plano, el programa que abren ya no existe. No hay nada marcado de forma predeterminada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目は、App が見つからなくなったバンドル ID の名前が付いています。バックグラウンド項目の場合は、起動するプログラムがもう存在しません。デフォルトでは何もチェックされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목들은 더 이상 찾을 수 없는 앱의 번들 ID 이름을 가지고 있으며, 백그라운드 항목은 실행할 프로그램이 더 이상 없습니다. 기본적으로 아무것도 체크되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些项目以 bundle ID 命名，但对应的 App 已经找不到；后台项目则是它要启动的程序已不存在。默认全部不勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些項目以 bundle ID 命名，但對應的 App 已經找不到；背景啟動項目則是它要啟動的程式已不存在。預設全部不勾。"
          }
        }
      }
    },
    "Things still run fine, but swapping may start soon.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo sigue funcionando bien, pero pronto puede empezar a usar intercambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ問題なく動いていますが、まもなくスワップが始まるかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직은 잘 작동하지만 곧 스왑이 시작될 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前运行还算流畅，但可能很快会开始使用交换空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還順，但可能很快會開始使用置換空間。"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac"
          }
        },
        "ja": {
          "stringUnit": {
