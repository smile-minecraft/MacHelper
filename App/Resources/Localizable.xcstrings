        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 휴지통으로 이동했습니다. 휴지통을 비우면 공간이 확보됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
