    "SSD": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSD"
          }
        }
      }
    },
    "Saved scan from %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次掃描時間：%@"
          }
