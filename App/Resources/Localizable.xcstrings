    "This page updates apps installed with Homebrew (brew install --cask). Install Homebrew from brew.sh to use it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página actualiza las apps instaladas con Homebrew (brew install --cask). Instala Homebrew desde brew.sh para usarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページは Homebrew（brew install --cask）でインストールした App をアップデートします。使うには brew.sh から Homebrew をインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지는 Homebrew(brew install --cask)로 설치한 앱을 업데이트합니다. 사용하려면 brew.sh에서 Homebrew를 설치하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面用于更新通过 Homebrew 安装的 App（brew install --cask）。请先从 brew.sh 安装 Homebrew。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一頁會更新用 Homebrew 安裝的 App（brew install --cask）。請先到 brew.sh 安裝 Homebrew。"
          }
        }
      }
    },
