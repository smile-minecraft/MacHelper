    "You’ll be notified like this when a threshold is crossed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un aviso así cuando se supere un umbral."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しきい値を超えると、このように通知されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임계값을 넘으면 이렇게 알림을 받습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
