        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值顏色"
          }
        }
      }
    },
    "Values that need attention get a pale yellow or red, close to white, so they stay easy to read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要注意的數值會變成接近白色的淡黃或淡紅，仍然清楚好讀。"
