        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 공간을 확보합니다. 정리하기 전에 모든 항목을 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全地释放空间。清理前，每一项都会先让你确认。"
