    },
    "Space macOS frees automatically when needed (mostly local Time Machine snapshots and system caches).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要時會自動釋放的空間（大多是 Time Machine 本機快照與系統快取）。"
          }
        }
      }
    },
    "Space used by items in the Trash is freed when you empty the Trash.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶的空間要等清空垃圾桶後才會釋放。"
          }
        }
      }
    },
    "Speed": {
      "localizations": {
