    },
    "Review what each category will do. Nothing changes until you choose Apply Import.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa qué hará cada categoría. No cambia nada hasta que elijas Aplicar importación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各カテゴリで何が行われるか確認してください。「読み込みを適用」を選ぶまで何も変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 범주에서 무엇이 바뀌는지 확인하십시오. ‘가져오기 적용’을 선택하기 전에는 아무것도 바뀌지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认每个类别会做什么。在你选择「应用导入」之前，不会更改任何设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認每個類別會做什麼。在你選擇「套用匯入」之前，不會變更任何設定。"
          }
        }
      }
    },
    "Settings files never include monitoring history, scan caches, operation logs, or background recording.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de ajustes nunca incluyen el historial de monitorización, las cachés de escaneo, los registros de operaciones ni el registro en segundo plano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルにはモニタ履歴、スキャンのキャッシュ、操作ログ、バックグラウンド記録は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일에는 모니터링 기록, 스캔 캐시, 작업 기록, 백그라운드 기록이 포함되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置文件不含监控历史、扫描缓存、操作日志或后台记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔不含監控歷史、掃描快取、操作紀錄或背景記錄。"
          }
        }
      }
    },
    "Settings imported.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes importados."
          }
