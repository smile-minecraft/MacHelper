    "Skipped %lld items: they contain git-tracked files or a nested repository.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitieron %lld elementos: contienen archivos seguidos por git o un repositorio anidado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目をスキップしました。git で管理されているファイルか、入れ子のリポジトリが含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목을 건너뛰었습니다. git으로 추적되는 파일이나 중첩된 저장소가 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过 %lld 项：其中包含 git 跟踪的文件或嵌套的仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已略過 %lld 項：含有 git 追蹤的檔案或巢狀 repository。"
          }
        }
      }
    },
