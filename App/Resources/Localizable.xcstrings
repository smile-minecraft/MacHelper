    "Trash %@ · deleted %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Papelera %@ · eliminados %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
