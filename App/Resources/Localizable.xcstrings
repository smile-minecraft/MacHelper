          "stringUnit": {
            "state": "translated",
            "value": "点按区块进入该文件夹；右键点按或拖到右侧收集篮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下區塊進入該資料夾；右鍵或拖到右側收集籃。"
          }
        }
      }
    },
    "Click a ring to open a folder, click the center to go up; right-click or drag items to the collector.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un anillo para abrir una carpeta y en el centro para subir; haz clic derecho o arrastra elementos al recolector."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングをクリックするとフォルダを開き、中央をクリックすると上の階層に戻ります。右クリックまたはドラッグで項目をコレクターに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링을 클릭하면 폴더가 열리고 가운데를 클릭하면 상위 폴더로 이동합니다. 항목을 오른쪽 클릭하거나 수집함으로 드래그하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按圆环进入文件夹，点中心返回上一层；右键点按或拖到右侧收集篮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下圓環進入資料夾，點中心返回上一層；右鍵或拖到右側收集籃。"
          }
        }
      }
    },
