    "Run Now": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即執行一次"
          }
        }
      }
    },
    "Run “machelper --help” in Terminal. ~/.local/bin must be in your PATH.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「終端機」執行「machelper --help」。~/.local/bin 需要在 PATH 裡。"
