    "Room for open apps. When it runs out, everything slows down.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio para las apps abiertas. Cuando se agota, todo va más lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いている App のための領域です。足りなくなるとすべてが遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 앱을 위한 공간입니다. 부족해지면 모든 것이 느려집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供打开的 App 使用的空间，不够时一切都会变慢。"
