    "Free Space Trend": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間趨勢"
          }
        }
      }
    },
    "Free space chart": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間圖表"
          }
        }
      }
    },
    "Free space on the startup disk": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動磁碟的可用空間"
          }
        }
      }
    },
    "Get Free Space Trend": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得可用空間趨勢"
          }
        }
      }
    },
    "Growing by about %@ a day.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天約增加 %@。"
          }
        }
      }
    },
    "Health Check": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健康檢查"
          }
        }
      }
    },
    "Hours of history": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史時數"
          }
        }
      }
    },
    "Largest by memory": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體最大"
          }
        }
      }
    },
    "Launch Agents": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動代理程式"
          }
        }
      }
    },
    "Login & Background Items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入與背景項目"
          }
        }
      }
    },
    "Login item": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入項目"
          }
        }
      }
    },
    "MacHelper records free space once an hour while it or background recording runs. The trend appears after about 12 hours.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacHelper 或背景記錄執行時，每小時記錄一次可用空間；大約 12 小時後會出現趨勢。"
          }
        }
      }
    },
    "No problems found in the last %lld hours.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 %lld 小時沒有發現問題。"
          }
        }
      }
    },
    "No problems found in this period.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段期間沒有發現問題。"
          }
        }
      }
    },
    "Not allowed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未允許"
          }
        }
      }
    },
    "Not enough data since the last big change for a trend yet (needs about 12 hours).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次大幅變動後的資料還不夠算出趨勢（約需 12 小時）。"
          }
        }
      }
    },
    "Note": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示"
          }
        }
      }
    },
    "Nothing to clean right now.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有可清理的項目。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正常"
          }
        }
      }
    },
    "Period": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "期間"
          }
        }
      }
    },
    "Preview Cleanup": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽清理"
          }
        }
      }
    },
    "Preview Low-Risk Cleanup": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽低風險清理"
          }
        }
      }
    },
    "Recorded": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已記錄"
          }
        }
      }
    },
    "Records": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄"
          }
        }
      }
    },
    "Returns free space on the startup disk and, when there’s enough hourly history, how fast it’s shrinking.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回傳啟動磁碟的可用空間；每小時紀錄足夠時，也會回傳減少的速度。"
          }
        }
      }
    },
    "Run Cleanup": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行清理"
          }
        }
      }
    },
    "Run Low-Risk Cleanup": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行低風險清理"
          }
        }
      }
    },
    "Run again": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新檢查"
          }
        }
      }
    },
    "Runs MacHelper’s health check on the recorded history and returns the findings as text.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據已記錄的歷史執行 MacHelper 健康檢查，並以文字回傳結果。"
          }
        }
      }
    },
    "Show": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示"
          }
        }
      }
    },
    "Show disabled": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示已停用"
          }
        }
      }
    },
    "Shrinking by about %@ a day; full in about %lld days at this rate.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天約減少 %1$@；照這個速度，約 %2$lld 天後會滿。"
          }
        }
      }
    },
    "Stable: changing by less than 50 MB a day.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "穩定：每天變化不到 50 MB。"
          }
        }
      }
    },
    "The history database couldn’t be opened.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟歷史資料庫。"
          }
        }
      }
    },
    "The startup disk’s free space couldn’t be read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取啟動磁碟的可用空間。"
          }
        }
      }
    },
    "Trash %@ · deleted %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶 %1$@ · 永久刪除 %2$@"
          }
        }
      }
    },
    "Turn on “Record process usage” in Settings → General → Data to see which processes were busiest.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到「設定 → 一般 → 資料管理」開啟「記錄程序用量」，就能看到哪些程序最忙。"
          }
        }
      }
    },
    "Uptime": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開機時間"
          }
        }
      }
    },
    "View": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視"
          }
        }
      }
    },
    "What each rule, detector or task removed in the records shown, largest first. Rules that never appear here may not be worth selecting.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前顯示的紀錄中，每條規則、偵測器或工作移除了多少，由大到小排列。從沒出現在這裡的規則，可能不值得勾選。"
          }
        }
      }
    },
    "What macOS has registered to run at login or in the background, including items apps add themselves. This list is read-only; change it in Login Items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 登記在登入時或背景執行的項目，包括 App 自行加入的。這份清單只供檢視，要變更請到「登入項目」。"
          }
        }
      }
    },
    "This permanently deletes all per-minute monitoring history, every metric it contains, and the hourly free-space history. It can’t be undone. Process usage history, sensor and core history, other settings, and the operation history are not affected.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除每分鐘的監控歷史（包含其中所有指標）與每小時的可用空間紀錄。此操作無法復原。程序用量歷史、感測器與核心歷史、其他設定與操作紀錄都不受影響。"
          }
        }
      }
    },
    "A low-risk cleanup would free %@.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低風險清理可以釋放 %@。"
          }
        }
      }
    },
    "Auto Clean only touches low-risk caches and logs, which are deleted directly and free space immediately (apps rebuild this data themselves).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動清理只處理低風險的快取與日誌，會直接刪除並立即釋放空間（App 會自行重建這些資料）。"
          }
        }
      }
    },
    "Cleaned %@.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已清理 %@。"
          }
        }
      }
    },
    "Delete %@ of low-risk caches and logs?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除 %@ 的低風險快取與日誌嗎？"
          }
        }
      }
    },
    "Delete directly: %@ of low-risk caches and logs that apps rebuild themselves. They don’t go to the Trash.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接刪除：%@ 的低風險快取與日誌，App 會自行重建，不會進垃圾桶。"
          }
        }
      }
    },
    "Deleted directly": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接刪除"
          }
        }
      }
    },
    "Deletes low-risk, selected-by-default caches and logs (the same selection as scheduled cleaning); apps rebuild this data themselves. Apps that are running are skipped. Asks before it starts.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除預設勾選的低風險快取與日誌（與排程清理相同的範圍），App 會自行重建這些資料。正在執行的 App 會跳過。開始前會先詢問。"
          }
        }
      }
    },
    "Empty the Trash: %@. This can’t be undone.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空垃圾桶：%@，無法復原。"
          }
        }
      }
    },
    "Measures how much a low-risk cleanup would free, without removing anything.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算低風險清理可以釋放多少空間，不會移除任何項目。"
          }
        }
      }
    },
    "Move to the Trash instead of deleting": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改為移到垃圾桶，不直接刪除"
          }
        }
      }
    },
    "This is only a preview; nothing is deleted until you click Clean. Low-risk items are deleted directly, medium and high risk go to the Trash.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這只是預覽，按下「清理」前不會刪除任何東西。低風險項目會直接刪除，中、高風險項目移到垃圾桶。"
          }
        }
      }
    },
    "To Trash": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個檔案"
          }
        }
      }
    },
    "Can’t read %@: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 %1$@：%2$@"
          }
        }
      }
    },
    "Delete old system logs and diagnostic reports as administrator: %@. Only files older than 30 days in the fixed system log folders.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以管理員權限直接刪除舊的系統日誌與診斷報告：%@。只處理固定系統日誌資料夾裡超過 30 天的檔案。"
          }
        }
      }
    },
    "Disable": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用"
          }
        }
      }
    },
    "Disable %@?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要停用 %@ 嗎？"
          }
        }
      }
    },
    "Enable the Helper in Settings to switch these": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中啟用 Helper 後才能切換"
          }
        }
      }
    },
    "Not applicable on this Mac; skipped.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 不適用，會略過。"
          }
        }
      }
    },
    "Nothing older than 30 days": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有超過 30 天的檔案"
          }
        }
      }
    },
    "Only tasks that are safe to repeat and lose nothing the system doesn’t rebuild can run unattended.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有可以安全重複執行、而且不會失去系統無法重建之資料的任務，才能在背景自動執行。"
          }
        }
      }
    },
    "Switched by the Helper for all users; can’t be removed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Helper 為所有使用者切換；不能刪除"
          }
        }
      }
    },
    "Switching affects only your account; can’t be removed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換只影響你的帳號；不能刪除"
          }
        }
      }
    },
    "System Logs": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統日誌"
          }
        }
      }
    },
    "System logs": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統日誌"
          }
        }
      }
    },
    "This system daemon is stopped for all users and won’t start again until you enable it here. The app that installed it may stop working properly (for example its updater, VPN or network helper). The plist isn’t changed or removed.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個系統背景程式會對所有使用者停止，直到你在這裡重新啟用前都不會再啟動。安裝它的 App 可能無法正常運作（例如更新程式、VPN 或網路輔助程式）。plist 檔不會被修改或刪除。"
          }
        }
      }
    },
    "Needs the Helper (Settings → Helper). Without it macOS would ask for an administrator password every time.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 Helper（設定 → Helper）。沒有 Helper，macOS 每次都會要求輸入管理員密碼。"
          }
        }
      }
    },
    "No process used the GPU in the last few seconds": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近幾秒沒有程序使用 GPU"
          }
        }
      }
    },
    "Needs the Helper": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 Helper"
          }
        }
      }
    },
    "%lld system items moved to the Trash by the Helper.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper 已把 %lld 個系統層級項目移到垃圾桶。"
          }
        }
      }
    },
    "%lld system-level items are moved to the Trash by the Helper.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個系統層級項目會由 Helper 移到垃圾桶。"
          }
        }
      }
    },
    "Checked items are moved to your Trash by the Helper, so you can put them back. Items matched only by name are left unchecked; check them only if they clearly belong to this app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選的項目會由 Helper 移到你的垃圾桶，之後可以放回原處。只依名稱比對到的項目預設不勾，確定屬於這個 App 才勾選。"
          }
        }
      }
    },
    "Enable the Helper in Settings to move these to the Trash; until then remove them manually.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中啟用 Helper 後才能把這些項目移到垃圾桶；在那之前請手動移除。"
          }
        }
      }
    },
    "Matched by name": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依名稱比對"
          }
        }
      }
    },
    "System Level": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統層級"
          }
        }
      }
    },
    "%@ Copy": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 副本"
          }
        }
      }
    },
    "%@ left. A cleanup now keeps things smooth.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩下 %@。現在清理一下，電腦會更順暢。"
          }
        }
      }
    },
    "Accent": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強調色"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進階"
          }
        }
      }
    },
    "Almost full": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快滿了"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀"
