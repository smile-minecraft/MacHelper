    "Warm is normal under load; the fans step in when needed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es normal que esté templado con carga; los ventiladores actúan cuando hace falta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負荷がかかっているときに温かいのは正常です。必要に応じてファンが回ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부하가 있을 때 따뜻한 것은 정상이며 필요하면 팬이 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负载高时变热是正常的，需要时风扇会自动加速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忙的時候變熱是正常的，需要時風扇會自動加速。"
          }
        }
      }
