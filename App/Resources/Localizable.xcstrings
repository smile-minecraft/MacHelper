    "Pixel: stepped corners and block borders, like a retro game.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Píxel: esquinas escalonadas y bordes de bloques, como un videojuego retro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクセル: レトロゲームのような段々の角とブロック状の枠線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "픽셀: 레트로 게임처럼 계단식 모서리와 블록 테두리."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素：阶梯状边角和方块边框，像复古游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像素：階梯狀邊角和方塊邊框，像復古遊戲。"
          }
        }
      }
    },
    "Retro game look with a pixel font and stepped corners.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspecto de videojuego retro con tipo de letra de píxeles y esquinas escalonadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクセルフォントと段々の角を使ったレトロゲーム風の見た目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "픽셀 서체와 계단식 모서리를 쓴 레트로 게임 모양."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素字体加上阶梯状边角的复古游戏风格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像素字體加上階梯狀邊角的復古遊戲風格。"
