    "Show the health score": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la puntuación de salud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルススコアを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 점수 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示健康分数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示健康分數"
          }
        }
      }
    },
    "The same score as on Overview, shown first in the menu bar as HP. It goes down for each problem found now or in the last 24 hours; Health Check lists what lowers it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma puntuación que en Resumen, mostrada al principio de la barra de menús como HP. Baja con cada problema encontrado ahora o en las últimas 24 horas; Revisión de estado muestra qué la baja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「概要」と同じスコアを、メニューバーの先頭に HP として表示します。現在または直近 24 時間に見つかった問題ごとに下がり、「ヘルスチェック」で理由を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개요와 같은 점수를 메뉴 막대 맨 앞에 HP로 표시합니다. 지금 또는 최근 24시간 동안 발견된 문제마다 점수가 내려가며, 상태 점검에서 이유를 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与概览页相同的分数，以 HP 显示在菜单栏最前面。当前或最近 24 小时发现的每个问题都会扣分；「健康检查」会列出扣分原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和概覽頁相同的分數，以 HP 顯示在選單列最前面。目前或最近 24 小時發現的每個問題都會扣分；「健康檢查」會列出扣分的原因。"
          }
        }
      }
    },
