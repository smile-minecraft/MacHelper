          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最耗 CPU 的程序"
          }
        }
      }
    },
    "Top processes by memory": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesos con más memoria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ使用量の多いプロセス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 사용량 상위 프로세스"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最耗内存的进程"
          }
        },
        "zh-Hant": {
