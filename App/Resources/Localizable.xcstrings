    "Size": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大小"
          }
        }
      }
    },
    "Skipped %lld items: they contain git-tracked files or a nested repository.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已略過 %lld 項：含有 git 追蹤的檔案或巢狀 repository。"
          }
        }
      }
    },
    "Skipped: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "略過：%@"
          }
        }
      }
    },
    "Some items weren’t processed (%lld): %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分項目未處理（%lld 項）：%@"
          }
        }
      }
    },
    "Space macOS frees automatically when needed (mostly local Time Machine snapshots and system caches).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要時會自動釋放的空間（大多是 Time Machine 本機快照與系統快取）。"
          }
        }
      }
    },
    "Space used by items in the Trash is freed when you empty the Trash.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶的空間要等清空垃圾桶後才會釋放。"
          }
        }
      }
    },
    "Speed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉速"
          }
        }
      }
    },
    "Start Scan": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始掃描"
          }
        }
      }
    },
    "Starts at login": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時啟動"
          }
        }
      }
    },
    "Starts on demand": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要時才啟動"
          }
        }
      }
    },
    "Startup Items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
