          }
        }
      }
    },
    "Without the Dock icon, MacHelper lives in the menu bar; its window opens from there.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不在 Dock 顯示時，MacHelper 只會出現在選單列，可以從那裡打開視窗。"
          }
        }
      }
    },
    "Write": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入"
          }
        }
      }
    },
    "You can also run it from the command line: machelper autoclean --now": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排程也可以用指令執行：machelper autoclean --now"
          }
        }
      }
    },
    "Your Mac is running hot": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 溫度偏高"
          }
        }
      }
    },
    "You’ll be notified like this when a threshold is crossed.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過門檻時，你會收到像這樣的通知。"
          }
        }
      }
    },
    "free of %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用，共 %@"
          }
        }
      }
    },
