    },
    "This file isn’t a MacHelper settings file. Nothing was changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es un archivo de ajustes de MacHelper. No se cambió nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは MacHelper の設定ファイルではありません。何も変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 MacHelper 설정 파일이 아닙니다. 아무것도 변경되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 MacHelper 的设置文件。没有更改任何设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
