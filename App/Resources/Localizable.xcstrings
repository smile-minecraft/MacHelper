          }
        }
      }
    },
    "Updates run brew upgrade --cask for each app, one at a time, and are recorded in the operation history. Apps that are open are quit first and reopened afterwards.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones ejecutan brew upgrade --cask para cada app, de una en una, y quedan en el historial de operaciones. Las apps abiertas se cierran antes y se vuelven a abrir después."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートは App ごとに 1 つずつ brew upgrade --cask を実行し、操作履歴に記録されます。開いている App は先に終了し、終わったら再び開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트는 앱마다 하나씩 brew upgrade --cask를 실행하며 작업 기록에 남습니다. 열려 있는 앱은 먼저 종료하고 끝난 뒤 다시 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新会逐个对每个 App 运行 brew upgrade --cask，并记录在操作日志中。正在运行的 App 会先退出，更新后再重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新會逐一對每個 App 執行 brew upgrade --cask，並記錄在操作紀錄中。開著的 App 會先結束，更新後再重新打開。"
          }
        }
      }
    },
