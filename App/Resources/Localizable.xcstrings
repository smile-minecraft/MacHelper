    "%lld cloud-only files were skipped and not downloaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitieron %lld archivos solo en la nube; no se descargaron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドのみのファイル %lld 個をスキップしました（ダウンロードしていません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 전용 파일 %lld개를 건너뛰었으며 다운로드하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过 %lld 个仅限云端的文件，未下载其内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已略過 %lld 個僅限雲端的檔案，未下載其內容。"
          }
        }
      }
    },
    "%lld cloud-only folders were skipped; their contents were not downloaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitieron %lld carpetas solo en la nube; su contenido no se descargó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドのみのフォルダ %lld 個をスキップしました。中身はダウンロードしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 전용 폴더 %lld개를 건너뛰었으며 내용은 다운로드하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过 %lld 个仅限云端的文件夹，未下载其内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已略過 %lld 個僅限雲端的資料夾，未下載其內容。"
          }
        }
      }
    },
    "%lld files could not be read.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer %lld archivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のファイルを読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개를 읽을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个文件无法读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個檔案無法讀取。"
          }
        }
      }
    },
    "%lld folders couldn’t be read; the results are incomplete.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer %lld carpetas; los resultados están incompletos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のフォルダを読み込めなかったため、結果は不完全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 %lld개를 읽을 수 없어 결과가 불완전합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个文件夹无法读取，结果不完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個資料夾無法讀取，結果不完整。"
          }
        }
      }
    },
