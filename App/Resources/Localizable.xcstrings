    "This file was created by a newer version of MacHelper and can’t be imported. Nothing was changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo se creó con una versión más reciente de MacHelper y no se puede importar. No se cambió nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは新しいバージョンの MacHelper で作成されたため読み込めません。何も変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 최신 버전의 MacHelper에서 만들어져 가져올 수 없습니다. 아무것도 변경되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件由较新版本的 MacHelper 创建，无法导入。没有更改任何设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
