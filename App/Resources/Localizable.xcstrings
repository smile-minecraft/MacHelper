    "macOS adds it to Login Items. Nothing runs until you allow it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lo añade a Ítems de inicio. No se ejecuta nada hasta que lo permitas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がログイン項目に追加します。許可するまでは何も実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 로그인 항목에 추가합니다. 허용하기 전까지는 실행되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会把它加入「登录项」。在你允许之前，它不会运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會把它加入「登入項目」。在你允許之前，它不會執行。"
          }
        }
      }
    },
