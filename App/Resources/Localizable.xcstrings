    "Without the Dock icon, MacHelper lives in the menu bar; its window opens from there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin el icono del Dock, MacHelper vive en la barra de menús; su ventana se abre desde allí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock アイコンがない場合、MacHelper はメニューバーに常駐し、ウインドウはそこから開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘이 없으면 MacHelper는 메뉴 막대에 있으며 윈도우는 메뉴 막대에서 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
