      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "Shares storage with another copy; deleting it alone frees almost nothing.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與另一份共用儲存空間，單獨刪除它幾乎不會釋放空間。"
          }
        }
      }
    },
    "Show in Dock": {
