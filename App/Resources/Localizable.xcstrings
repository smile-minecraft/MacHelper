      }
    },
    "Showing %lld of %lld records": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando %lld de %lld registros"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 件中 %1$lld 件を表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 %2$lld개 중 %1$lld개 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
