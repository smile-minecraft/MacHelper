          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視"
          }
        }
      }
    },
    "What each rule, detector or task removed in the records shown, largest first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que eliminó cada regla, detector o tarea en los registros mostrados, de mayor a menor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の記録で各ルール、検出器、作業が削除した量を大きい順に示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 기록에서 각 규칙, 감지기, 작업이 제거한 양을 큰 순서로 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示的记录中，每条规则、检测器或任务移除了多少，从大到小排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前顯示的紀錄中，每條規則、偵測器或工作移除了多少，由大到小排列。"
          }
        }
      }
    },
    "What macOS has registered to run at login or in the background, including items apps add themselves. This list is read-only; change it in Login Items.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que macOS tiene registrado para abrirse al iniciar sesión o en segundo plano, incluidos los ítems que añaden las propias apps. Esta lista es de solo lectura; cámbiala en Ítems de inicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時やバックグラウンドで実行するよう macOS に登録されているもので、App が自分で追加した項目も含みます。この一覧は読み取り専用です。変更は「ログイン項目」で行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시나 백그라운드에서 실행되도록 macOS에 등록된 항목으로, 앱이 직접 추가한 항목도 포함합니다. 이 목록은 읽기 전용이며 변경은 로그인 항목에서 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 注册在登录时或后台运行的项目，包括 App 自行添加的。这份列表只供查看，要更改请到「登录项」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 登記在登入時或背景執行的項目，包括 App 自行加入的。這份清單只供檢視，要變更請到「登入項目」。"
          }
        }
      }
    },
    "This permanently deletes all per-minute monitoring history, every metric it contains, and the hourly free-space history. It can’t be undone. Process usage history, sensor and core history, other settings, and the operation history are not affected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente todo el historial de monitorización por minuto, todas sus métricas y el historial de espacio libre por horas. No se puede deshacer. No afecta al historial de uso de procesos, al de sensores y núcleos, a otros ajustes ni al historial de operaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分ごとのモニタ履歴（含まれるすべての項目）と、1 時間ごとの空き容量の履歴を完全に削除します。元に戻せません。プロセス使用量の履歴、センサーとコアの履歴、その他の設定、操作履歴には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분 단위 모니터링 기록과 그 안의 모든 지표, 시간별 여유 공간 기록을 영구적으로 삭제합니다. 되돌릴 수 없습니다. 프로세스 사용량 기록, 센서 및 코어 기록, 기타 설정, 작업 기록에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除每分钟的监控历史（包含其中所有指标）与每小时的可用空间记录。此操作无法撤销。进程用量历史、传感器与核心历史、其他设置与操作日志都不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除每分鐘的監控歷史（包含其中所有指標）與每小時的可用空間紀錄。此操作無法復原。程序用量歷史、感測器與核心歷史、其他設定與操作紀錄都不受影響。"
          }
        }
      }
    },
    "A low-risk cleanup would free %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una limpieza de riesgo bajo liberaría %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低リスクのクリーンで %@ 解放できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 위험 정리로 %@을(를) 확보할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低风险清理可以释放 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低風險清理可以釋放 %@。"
          }
        }
      }
    },
    "Auto Clean only touches low-risk caches and logs, which are deleted directly and free space immediately (apps rebuild this data themselves).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza automática solo toca cachés y registros de riesgo bajo, que se eliminan directamente y liberan espacio al momento (las apps vuelven a crear estos datos)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動クリーンが対象にするのは低リスクのキャッシュとログだけです。これらは直接削除され、すぐに容量が空きます（App が自分で作り直すデータです）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 정리는 낮은 위험 캐시와 로그만 다루며, 이 항목은 바로 삭제되어 즉시 공간이 확보됩니다(앱이 직접 다시 만드는 데이터)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动清理只处理低风险的缓存与日志，会直接删除并立即释放空间（App 会自行重建这些数据）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動清理只處理低風險的快取與日誌，會直接刪除並立即釋放空間（App 會自行重建這些資料）。"
          }
        }
      }
    },
    "Cleaned %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se limpiaron %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をクリーンしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 정리했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已清理 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已清理 %@。"
          }
        }
      }
    },
    "Delete %@ of low-risk caches and logs?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@ de cachés y registros de riesgo bajo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低リスクのキャッシュとログ %@ を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 위험 캐시 및 로그 %@을(를) 삭제하겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除 %@ 的低风险缓存与日志吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除 %@ 的低風險快取與日誌嗎？"
          }
        }
      }
    },
    "Delete directly: %@ of low-risk caches and logs that apps rebuild themselves. They don’t go to the Trash.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar directamente: %@ de cachés y registros de riesgo bajo que las apps vuelven a crear. No van a la Papelera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接削除: App が自分で作り直す低リスクのキャッシュとログ %@。ゴミ箱には入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 삭제: 앱이 직접 다시 만드는 낮은 위험 캐시 및 로그 %@. 휴지통으로 이동하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接删除：%@ 的低风险缓存与日志，App 会自行重建，不会进入废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接刪除：%@ 的低風險快取與日誌，App 會自行重建，不會進垃圾桶。"
          }
        }
      }
    },
    "Deleted directly": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado directamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 삭제됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接刪除"
          }
        }
      }
    },
    "Deletes low-risk, selected-by-default caches and logs (the same selection as scheduled cleaning); apps rebuild this data themselves. Apps that are running are skipped. Asks before it starts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las cachés y registros de riesgo bajo seleccionados de forma predeterminada (la misma selección que la limpieza programada); las apps vuelven a crear estos datos. Se omiten las apps abiertas. Pregunta antes de empezar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトで選択される低リスクのキャッシュとログ（定期クリーンと同じ選択）を削除します。App が自分で作り直すデータです。実行中の App はスキップします。開始前に確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본으로 선택되는 낮은 위험 캐시와 로그(예약 정리와 같은 선택)를 삭제합니다. 앱이 직접 다시 만드는 데이터이며 실행 중인 앱은 건너뜁니다. 시작하기 전에 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除默认勾选的低风险缓存与日志（与定时清理的范围相同），App 会自行重建这些数据。会跳过正在运行的 App。开始前会先询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除預設勾選的低風險快取與日誌（與排程清理相同的範圍），App 會自行重建這些資料。正在執行的 App 會跳過。開始前會先詢問。"
          }
        }
      }
    },
    "Empty the Trash: %@. This can’t be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaciar la Papelera: %@. No se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にする: %@。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 비우기: %@. 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空废纸篓：%@，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空垃圾桶：%@，無法復原。"
          }
        }
      }
    },
    "Measures how much a low-risk cleanup would free, without removing anything.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide cuánto liberaría una limpieza de riesgo bajo, sin eliminar nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除せずに、低リスクのクリーンでどれだけ解放できるかを測ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 제거하지 않고 낮은 위험 정리로 얼마나 확보할 수 있는지 측정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算低风险清理可以释放多少空间，不会移除任何项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算低風險清理可以釋放多少空間，不會移除任何項目。"
          }
        }
      }
    },
    "Move to the Trash instead of deleting": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover a la Papelera en lugar de eliminar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除せずにゴミ箱に入れる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하지 않고 휴지통으로 이동"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改为移到废纸篓，不直接删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改為移到垃圾桶，不直接刪除"
          }
        }
      }
    },
    "Low-risk items are deleted directly, medium and high risk go to the Trash.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de riesgo bajo se eliminan directamente; los de riesgo medio y alto van a la Papelera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低リスクの項目は直接削除し、中・高リスクの項目はゴミ箱に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 위험 항목은 바로 삭제되고 중간 및 높은 위험 항목은 휴지통으로 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低风险项目会直接删除，中、高风险项目会移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低風險項目會直接刪除，中、高風險項目移到垃圾桶。"
          }
        }
      }
    },
    "To Trash": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la Papelera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のファイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個檔案"
          }
        }
      }
    },
    "Can’t read %@: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer %@: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を読み取れません: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 읽을 수 없음: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %1$@：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 %1$@：%2$@"
          }
        }
      }
    },
    "Delete old system logs and diagnostic reports as administrator: %@. Only files older than 30 days in the fixed system log folders.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar como administrador los registros del sistema y los informes de diagnóstico antiguos: %@. Solo archivos de más de 30 días en las carpetas fijas de registros del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者として古いシステムログと診断レポートを削除: %@。決まったシステムログフォルダ内の 30 日より古いファイルだけが対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자로 오래된 시스템 로그와 진단 보고서 삭제: %@. 정해진 시스템 로그 폴더에서 30일이 지난 파일만 대상입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以管理员权限直接删除旧的系统日志与诊断报告：%@。只处理固定系统日志文件夹里超过 30 天的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以管理員權限直接刪除舊的系統日誌與診斷報告：%@。只處理固定系統日誌資料夾裡超過 30 天的檔案。"
          }
        }
      }
    },
    "Disable": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비활성화"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用"
          }
        }
      }
    },
    "Disable %@?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desactivar %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を無効にしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 비활성화하겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要禁用 %@ 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要停用 %@ 嗎？"
          }
        }
      }
    },
    "Enable the Helper in Settings to switch these": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el Helper en Ajustes para cambiarlos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えるには「設定」で Helper を有効にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환하려면 설정에서 Helper를 활성화하십시오"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中启用 Helper 后才能切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中啟用 Helper 後才能切換"
          }
        }
      }
    },
    "Not applicable on this Mac; skipped.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No aplica en este Mac; omitido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac では該当しないため、スキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 해당하지 않아 건너뛰었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不适用，会跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 不適用，會略過。"
          }
        }
      }
    },
    "Nothing older than 30 days": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de más de 30 días"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30 日より古いものはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일이 지난 항목 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有超过 30 天的文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有超過 30 天的檔案"
          }
        }
      }
    },
    "Only tasks that are safe to repeat and lose nothing the system doesn’t rebuild can run unattended.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo pueden ejecutarse sin supervisión las tareas que se pueden repetir con seguridad y no pierden nada que el sistema no vuelva a crear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無人で実行できるのは、繰り返しても安全で、システムが作り直せないものを失わない作業だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복해도 안전하고 시스템이 다시 만들지 못하는 것을 잃지 않는 작업만 자동으로 실행할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有可以安全重复运行、并且不会丢失系统无法重建的数据的任务，才能在后台自动运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有可以安全重複執行、而且不會失去系統無法重建之資料的任務，才能在背景自動執行。"
          }
        }
      }
    },
    "Switched by the Helper for all users; can’t be removed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Helper lo cambia para todos los usuarios; no se puede eliminar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper がすべてのユーザに対して切り替えます。削除はできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper가 모든 사용자에 대해 전환하며 제거할 수 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Helper 为所有用户切换；不能删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Helper 為所有使用者切換；不能刪除"
          }
        }
      }
    },
    "Switching affects only your account; can’t be removed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio solo afecta a tu cuenta; no se puede eliminar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えはあなたのアカウントだけに影響します。削除はできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환은 내 계정에만 적용되며 제거할 수 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换只影响你的账户；不能删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換只影響你的帳號；不能刪除"
          }
        }
      }
    },
    "System Logs": {
      "localizations": {
        "es": {
          "stringUnit": {
