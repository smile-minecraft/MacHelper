        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンを途中で停止しました。それまでに確認した場所だけを表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔이 일찍 중지되었습니다. 그전까지 확인한 위치만 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
