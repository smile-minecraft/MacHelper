    "Scan caches, logs and leftovers, then clean what you pick.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea cachés, registros y restos, y limpia lo que elijas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ、ログ、残りファイルをスキャンして、選んだものをクリーンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시, 로그, 잔여 파일을 스캔한 다음 선택한 항목을 정리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描缓存、日志与残留文件，再清理你勾选的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描快取、日誌與殘留檔，再清理你勾選的項目。"
          }
        }
      }
    },
    "Scan first to list what can be cleaned.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea primero para ver qué se puede limpiar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずスキャンして、クリーンできるものを一覧にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 스캔하여 정리할 수 있는 항목을 확인하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先扫描并列出可清理的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先掃描並列出可清理的項目。"
          }
        }
      }
    },
    "Scan the same location again later to see which folders grew or shrank.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a escanear la misma ubicación más adelante para ver qué carpetas crecieron o se redujeron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで同じ場所をもう一度スキャンすると、どのフォルダが増えたか減ったかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 같은 위치를 다시 스캔하면 어떤 폴더가 커지거나 작아졌는지 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后再扫描同一个位置，就能看到哪些文件夹变大或变小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後再掃描同一個位置，就能看到哪些資料夾變大或變小。"
          }
        }
      }
    },
    "Scanned %@ files · %@": {
      "localizations": {
