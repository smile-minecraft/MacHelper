    "%lld system folders are protected by macOS and weren’t measured.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld carpetas del sistema están protegidas por macOS y no se midieron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のシステムフォルダは macOS に保護されているため測定していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 폴더 %lld개는 macOS가 보호하고 있어 측정하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个系统文件夹受 macOS 保护，没有计算在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個系統資料夾受 macOS 保護，沒有計算在內。"
          }
        }
      }
    },
    "Protected by macOS": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegidas por macOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS による保護"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
