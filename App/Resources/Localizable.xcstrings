            "value": "無法匯入"
          }
        }
      }
    },
    "Nothing in this file will replace a setting on this Mac. No changes will be made.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案沒有可取代的設定，不會變更任何內容。"
