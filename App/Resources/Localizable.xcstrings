{
  "sourceLanguage": "en",
  "strings": {
    "%@ files": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個檔案"
          }
        }
      }
    },
    "%@ is running. Quit it first.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在執行，請先結束。"
          }
        }
      }
    },
    "%@ items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個項目"
          }
        }
      }
    },
    "%@ selected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選 %@"
          }
        }
      }
    },
    "%@ selected, %lld maintenance tasks": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選 %@，%lld 項維護工作"
          }
        }
      }
    },
    "%@ × %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ × %lld"
          }
        }
      }
    },
    "%@; selected together with “Also remove app data”": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，跟著「一併移除 App 資料」一起選"
          }
        }
      }
    },
    "%lld GB": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld GB"
          }
        }
      }
    },
    "%lld folders couldn’t be read; the results are incomplete.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個資料夾無法讀取，結果不完整。"
          }
        }
      }
    },
    "%lld groups · %@ reclaimable": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 組 · 可釋放 %@"
          }
        }
      }
    },
    "%lld items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項"
          }
        }
      }
    },
    "%lld items · %@ to the Trash · %@ deleted": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項 · 移到垃圾桶 %@ · 已刪除 %@"
          }
        }
      }
    },
    "%lld local snapshots": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機快照 %lld 個"
          }
        }
      }
    },
    "%lld rpm/s": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld rpm/秒"
          }
        }
      }
    },
    "%lld s": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        }
      }
    },
    "%lld° %lld%%": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld度 %lld%%"
          }
        }
      }
    },
    "1 hour": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小時"
          }
        }
      }
    },
    "15 min": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分"
          }
        }
      }
    },
    "24 hours": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "24 小時"
          }
        }
      }
    },
    "5 min": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分"
          }
        }
      }
    },
    "7 days": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        }
      }
    },
    "A fixed speed needs the app to keep running; %lld seconds after the app quits, control returns to the system.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定轉速需要 App 持續執行；App 結束 %lld 秒後會自動交還系統。"
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀寫活動"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入"
          }
        }
      }
    },
    "Add Project Folder…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入專案資料夾…"
          }
        }
      }
    },
    "Add Rule": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增規則"
          }
        }
      }
    },
    "Add point": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增控制點"
          }
        }
      }
    },
    "Add the folders where you keep projects to find rebuildable artifacts such as node_modules, target and .build.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入你放專案的資料夾，就能找出 node_modules、target、.build 等可以重建的產物。"
          }
        }
      }
    },
    "Add to Collector": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入收集籃"
          }
        }
      }
    },
    "Alerts": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "All kinds": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有類型"
          }
        }
      }
    },
    "All operations are logged in ~/Library/Logs/MacHelper/operations.jsonl": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有操作都記錄在 ~/Library/Logs/MacHelper/operations.jsonl"
          }
        }
      }
    },
    "Allow MacHelper to run in the background in System Settings → General → Login Items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 → 一般 → 登入項目」允許 MacHelper 在背景執行。"
          }
        }
      }
    },
    "Also remove app data (Application Support, Containers, ~/.name: may contain your documents, settings or sign-in data)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一併移除 App 資料（Application Support、Containers、~/.名稱：可能有你的文件、設定或登入資訊）"
          }
        }
      }
    },
    "Any time": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不限時間"
          }
        }
      }
    },
    "App Caches": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 快取"
          }
        }
      }
    },
    "App signature": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 簽章"
          }
        }
      }
    },
    "Applied": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已套用"
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        }
      }
    },
    "Apps may slow down. Quit apps you don’t need, or check the top processes in MacHelper.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 可能會變慢。請結束用不到的 App，或在 MacHelper 查看最耗資源的程序。"
          }
        }
      }
    },
    "Archives": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮檔"
          }
        }
      }
    },
    "At most one notification of each kind every %lld minutes.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一類通知每 %lld 分鐘最多一次。"
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊"
          }
        }
      }
    },
    "Auto Clean": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動清理"
          }
        }
      }
    },
    "Auto Clean: On": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動清理：開"
          }
        }
      }
    },
    "Auto Clean…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動清理…"
          }
        }
      }
    },
    "Automatic (System)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動（系統）"
          }
        }
      }
    },
    "Averages per %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每 %@ 平均"
          }
        }
      }
    },
    "Background items that apps register themselves are managed in Login Items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 自行註冊的背景項目請到「登入項目」管理。"
          }
        }
      }
    },
    "Balanced": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡"
          }
        }
      }
    },
    "Bar": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長條"
          }
        }
      }
    },
    "Battery": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池"
          }
        }
      }
    },
    "Browsers": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器"
          }
        }
      }
    },
    "CPU at %@. Check the top processes below.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 目前 %@，看看下方最耗資源的程序。"
          }
        }
      }
    },
    "CPU die %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 晶片 %@"
          }
        }
      }
    },
    "CPU temperature above": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 溫度高於"
          }
        }
      }
    },
    "CPU temperature has been %@ for over 2 minutes.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 溫度已維持在 %@ 超過 2 分鐘。"
          }
        }
      }
    },
    "Calibration sensor": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "校準感測器"
          }
        }
      }
    },
    "Can’t uninstall: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解除安裝：%@"
          }
        }
      }
    },
    "Capacity": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "容量"
          }
        }
      }
    },
    "Changes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變化"
          }
        }
      }
    },
    "Charge": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電量"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇"
          }
        }
      }
    },
    "Choose a location to analyze, then click Scan. Scanning only reads; it never changes any files.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要分析的位置，然後按「掃描」。掃描只會讀取，不會修改任何檔案。"
          }
        }
      }
    },
    "Choose an App to Uninstall": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要解除安裝的 App"
          }
        }
      }
    },
    "Clean": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理"
          }
        }
      }
    },
    "Clean Up": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理"
          }
        }
      }
    },
    "Clean the selected %@?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理已選的 %@？"
          }
        }
      }
    },
    "Cleaned %lld items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已清理 %lld 項。"
          }
        }
      }
    },
    "Cleaned caches free space immediately and can’t be restored from the Trash (apps rebuild this data themselves).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清掉的快取會立刻釋放空間，無法從垃圾桶復原（這些都是 App 會自己重建的資料）。"
          }
        }
      }
    },
    "Cleaned items go to the Trash; the space is freed once you empty it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清掉的項目會移到垃圾桶，要清空垃圾桶後才會真正釋放空間。"
          }
        }
      }
    },
    "Cleaning Complete": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理完成"
          }
        }
      }
    },
    "Cleaning…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在清理…"
          }
        }
      }
    },
    "Clean…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理…"
          }
        }
      }
    },
    "Click a block to open its folder; right-click or drag items to the collector.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下區塊進入該資料夾；右鍵或拖到右側收集籃。"
          }
        }
      }
    },
    "Click a ring to open a folder, click the center to go up; right-click or drag items to the collector.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下圓環進入資料夾，點中心返回上一層；右鍵或拖到右側收集籃。"
          }
        }
      }
    },
    "Clone": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製體"
          }
        }
      }
    },
    "Collect All but the Oldest": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留最舊的，其餘加入收集籃"
          }
        }
      }
    },
    "Collector": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收集籃"
          }
        }
      }
    },
    "Command-line tool": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令列工具"
          }
        }
      }
    },
    "Compact (name above value)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精簡顯示（名稱在上、數值在下）"
          }
        }
      }
    },
    "Compared with the scan of %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 %@ 的掃描相比"
          }
        }
      }
    },
    "Comparing file contents…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在比對檔案內容…"
          }
        }
      }
    },
    "Compressed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已壓縮"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線"
          }
        }
      }
    },
    "Contents": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容"
          }
        }
      }
    },
    "Copy Label": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝標籤"
          }
