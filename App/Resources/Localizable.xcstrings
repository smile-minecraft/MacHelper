    },
    "Collecting is disabled for a saved scan. Scan again to update it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede recoger en un escaneo guardado. Vuelve a escanear para actualizarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したスキャンではコレクターに追加できません。もう一度スキャンして更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 스캔에서는 수집할 수 없습니다. 다시 스캔하여 업데이트하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的扫描不能收集项目，请重新扫描以更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的掃描不能收集項目，請重新掃描以更新。"
          }
        }
      }
    },
    "Collecting, removing, and duplicate search are disabled for a saved scan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un escaneo guardado no se puede recoger, eliminar ni buscar duplicados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したスキャンでは、コレクターへの追加、削除、重複検索は使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 스캔에서는 수집, 제거, 중복 검색을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的扫描只能浏览：收集、移到废纸篓和重复文件比较已禁用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的掃描只能瀏覽：收集、移到垃圾桶和重複檔案比對已停用。"
          }
        }
      }
    },
