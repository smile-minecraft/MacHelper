          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 %@ · 삭제 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓 %1$@ · 永久删除 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶 %1$@ · 永久刪除 %2$@"
          }
        }
      }
    },
    "Turn on “Record process usage” in Settings → General → Data to see which processes were busiest.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Registrar uso de procesos» en Ajustes → General → Datos para ver qué procesos estuvieron más activos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのプロセスが忙しかったかを見るには、「設定」→「一般」→「データ」で「プロセス使用量を記録」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 프로세스가 가장 바빴는지 보려면 설정 → 일반 → 데이터에서 ‘프로세스 사용량 기록’을 켜십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「设置」→「通用」→「数据管理」打开「记录进程用量」，就能看到哪些进程最忙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到「設定 → 一般 → 資料管理」開啟「記錄程序用量」，就能看到哪些程序最忙。"
          }
        }
      }
    },
    "Uptime": {
      "localizations": {
