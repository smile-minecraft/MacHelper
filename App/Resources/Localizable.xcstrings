    "Allow MacHelper to run in the background in System Settings → General → Login Items.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que MacHelper se ejecute en segundo plano en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」→「一般」→「ログイン項目」で MacHelper のバックグラウンド実行を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 로그인 항목에서 MacHelper가 백그라운드에서 실행되도록 허용하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「系统设置 → 通用 → 登录项」允许 MacHelper 在后台运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 → 一般 → 登入項目」允許 MacHelper 在背景執行。"
          }
        }
      }
    },
    "Also remove app data (Application Support, Containers, ~/.name: may contain your documents, settings or sign-in data)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar también los datos de la app (Application Support, Containers, ~/.nombre: pueden contener tus documentos, ajustes o datos de inicio de sesión)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App のデータも削除（Application Support、Containers、~/.name。書類、設定、サインイン情報が含まれる場合があります）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 데이터도 제거(Application Support, Containers, ~/.name: 문서, 설정 또는 로그인 데이터가 있을 수 있음)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一并移除 App 数据（Application Support、Containers、~/.名称：可能有你的文档、设置或登录信息）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一併移除 App 資料（Application Support、Containers、~/.名稱：可能有你的文件、設定或登入資訊）"
          }
        }
      }
    },
