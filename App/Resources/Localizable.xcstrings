{
  "sourceLanguage": "en",
  "strings": {
    "%@ files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ archivos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個のファイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %@개"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個檔案"
          }
        }
      }
    },
    "%@ is running. Quit it first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está abierto. Ciérralo primero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が実行中です。先に終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 실행 중입니다. 먼저 종료하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行，请先退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在執行，請先結束。"
          }
        }
      }
    },
    "%@ items": {
      "localizations": {
        "es": {
          "stringUnit": {
