    "Space macOS frees automatically when needed (mostly local Time Machine snapshots and system caches).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio que macOS libera solo cuando hace falta (sobre todo instantáneas locales de Time Machine y cachés del sistema)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要に応じて macOS が自動で解放する容量です（主に Time Machine のローカルスナップショットとシステムキャッシュ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요할 때 macOS가 자동으로 확보하는 공간입니다(주로 Time Machine 로컬 스냅샷과 시스템 캐시)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要时会自动释放的空间（大多是 Time Machine 本地快照与系统缓存）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要時會自動釋放的空間（大多是 Time Machine 本機快照與系統快取）。"
          }
        }
      }
    },
    "Space used by items in the Trash is freed when you empty the Trash.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio que ocupan los elementos de la Papelera se libera al vaciarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱の項目が使っている容量は、ゴミ箱を空にすると解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 있는 항목이 쓰는 공간은 휴지통을 비우면 확보됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓中的项目所占的空间，要清空废纸篓后才会释放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶的空間要等清空垃圾桶後才會釋放。"
          }
        }
      }
    },
