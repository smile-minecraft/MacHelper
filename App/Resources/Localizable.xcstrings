        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曲線溫度 %@"
          }
        }
      }
    },
    "Custom": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂"
          }
        }
      }
    },
    "Daily": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天"
          }
        }
      }
