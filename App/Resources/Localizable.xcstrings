    "CPU and memory: average · highest. Temperature: highest. Power: average.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU y memoria: promedio · máximo. Temperatura: máxima. Energía: promedio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU とメモリ: 平均 · 最高。温度: 最高。電力: 平均。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 및 메모리: 평균 · 최고. 온도: 최고. 전력: 평균."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 与内存：平均 · 最高。温度：最高。功耗：平均。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 與記憶體：平均 · 最高。溫度：最高。功耗：平均。"
          }
        }
      }
    },
    "CPU is the share of one core while the process was among the busiest.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La CPU es la proporción de un núcleo mientras el proceso estaba entre los más activos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU は、そのプロセスが上位にいた間の 1 コアに対する割合です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU는 프로세스가 상위에 있는 동안 코어 하나에 대한 비율입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 是该进程处于最忙排行期间占用单个核心的比例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 是該程序列入最忙排行期間占用單一核心的比例。"
          }
        }
      }
    },
