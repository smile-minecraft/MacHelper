    "Scan stopped early. Only the places checked before that are listed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo se detuvo antes de tiempo. Solo se muestran los lugares revisados hasta entonces."
          }
