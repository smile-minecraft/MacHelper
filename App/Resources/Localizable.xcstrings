    "Regularly cleans low-risk items in the background: app caches, logs, browser and developer tool caches. Running apps are skipped, the Trash is never emptied, and MacHelper doesn’t need to be open.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定期在背景清理「低風險」項目：App 快取、日誌、瀏覽器與開發工具快取。正在執行的 App 會略過，不會清空垃圾桶，也不需要開著 MacHelper。"
          }
        }
      }
    },
    "Relaunch": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Remove %@?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@？"
          }
        }
      }
    },
    "Remove apps together with everything they left behind.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連同殘留檔一起移除 App。"
          }
