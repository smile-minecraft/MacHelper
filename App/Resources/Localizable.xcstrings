        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴重"
          }
        }
      }
    },
    "Current": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前"
          }
        }
      }
    },
