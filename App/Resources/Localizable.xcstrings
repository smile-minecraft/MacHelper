          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App が自分で登録するバックグラウンド項目は「ログイン項目」で管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
