    "Add the folders where you keep projects to find rebuildable artifacts such as node_modules, target and .build.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade las carpetas donde guardas tus proyectos para encontrar artefactos que se pueden regenerar, como node_modules, target y .build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトを置いているフォルダを追加すると、node_modules、target、.build など再生成できるファイルを探せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트를 보관하는 폴더를 추가하면 node_modules, target, .build처럼 다시 만들 수 있는 산출물을 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你放项目的文件夹，就能找出 node_modules、target、.build 等可以重建的产物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入你放專案的資料夾，就能找出 node_modules、target、.build 等可以重建的產物。"
          }
        }
      }
    },
