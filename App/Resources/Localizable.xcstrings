    "Choose which values appear and their graph style in the Menu Bar tab.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué valores aparecen y su estilo de gráfico en la pestaña Barra de menús."
          }
        },
