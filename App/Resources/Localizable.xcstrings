    "Free up space safely. You see everything before it’s cleaned.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio con seguridad. Ves todo antes de que se limpie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に容量を空けます。クリーンする前にすべて確認できます。"
          }
