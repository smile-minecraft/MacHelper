    "%@; selected together with “Also remove app data”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; se selecciona junto con «Eliminar también los datos de la app»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。「App のデータも削除」と一緒に選択されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. ‘앱 데이터도 제거’와 함께 선택됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，与「一并移除 App 数据」一同选中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，跟著「一併移除 App 資料」一起選"
          }
        }
      }
    },
