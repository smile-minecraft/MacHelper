    "Your background items": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ítems en segundo plano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のバックグラウンド項目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 백그라운드 항목"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的后台项目"
          }
        },
        "zh-Hant": {
