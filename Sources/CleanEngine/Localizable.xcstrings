{
  "sourceLanguage": "en",
  "strings": {
    "%@ is running": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está abierto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が実行中です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 실행 중"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在執行"
          }
        }
      }
    },
    "%lld items not processed: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementos sin procesar: %@"
