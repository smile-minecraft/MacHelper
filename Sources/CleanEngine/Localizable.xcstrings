    "Clears the preview thumbnail cache and reloads QuickLook plug-ins, fixing wrong or stale thumbnails.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la caché de miniaturas y vuelve a cargar los plug-ins de Vista rápida, para corregir miniaturas erróneas o desactualizadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューのサムネールキャッシュを消去し、クイックルックのプラグインを読み込み直して、間違ったサムネールや古いサムネールを直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 보기 썸네일 캐시를 지우고 훑어보기 플러그인을 다시 불러와 잘못되거나 오래된 썸네일을 고칩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除预览缩略图缓存并重新加载快速查看插件，修复错误或过时的缩略图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除預覽縮圖快取並重新載入 QuickLook 外掛，修正縮圖錯誤或過時。"
          }
        }
      }
    },
