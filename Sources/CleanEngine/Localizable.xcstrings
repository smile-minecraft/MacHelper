    "Removes iOS simulators whose runtime no longer exists (xcrun simctl delete unavailable).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los simuladores de iOS cuyo runtime ya no existe (xcrun simctl delete unavailable)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランタイムがなくなった iOS シミュレータを削除します（xcrun simctl delete unavailable）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "런타임이 더 이상 없는 iOS 시뮬레이터를 제거합니다(xcrun simctl delete unavailable)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除运行时已不存在的 iOS 模拟器（xcrun simctl delete unavailable）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除對應 runtime 已不存在的 iOS 模擬器（xcrun simctl delete unavailable）。"
          }
        }
      }
    },
    "Removes old versions of installed packages and stale downloads (brew cleanup).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina versiones antiguas de los paquetes instalados y descargas obsoletas (brew cleanup)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みパッケージの古いバージョンと古いダウンロードを削除します（brew cleanup）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 패키지의 이전 버전과 오래된 다운로드를 제거합니다(brew cleanup)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除已安装软件包的旧版本与过期下载（brew cleanup）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除已安裝套件的舊版本與過期下載（brew cleanup）。"
          }
        }
      }
    },
    "Removes stopped containers, unused networks, dangling images and build cache (docker system prune -f). Docker must be running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina contenedores detenidos, redes sin usar, imágenes huérfanas y la caché de compilación (docker system prune -f). Docker debe estar en marcha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止したコンテナ、未使用のネットワーク、宙に浮いたイメージ、ビルドキャッシュを削除します（docker system prune -f）。Docker が動いている必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지된 컨테이너, 사용하지 않는 네트워크, 댕글링 이미지, 빌드 캐시를 제거합니다(docker system prune -f). Docker가 실행 중이어야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除停止的容器、未使用的网络、悬空镜像与构建缓存（docker system prune -f）。需要 Docker 正在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除停止的容器、未使用的網路、懸空映像與建置快取（docker system prune -f）。需要 Docker 正在執行。"
          }
        }
      }
    },
