        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目は未処理: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목 처리되지 않음: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项未处理：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項未處理：%@"
          }
        }
      }
    },
