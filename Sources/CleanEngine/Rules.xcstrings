        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés web, de código y de GPU de Visual Studio Code, paquetes de extensiones descargados y registros antiguos. No afecta a los ajustes, las extensiones ni los espacios de trabajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual Studio Code の Web、コード、GPU のキャッシュ、ダウンロードした拡張機能パッケージ、古いログ。設定、拡張機能、ワークスペースには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual Studio Code의 웹, 코드, GPU 캐시, 내려받은 확장 프로그램 패키지, 오래된 로그. 설정, 확장 프로그램, 작업 영역에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual Studio Code 的网页、代码与 GPU 缓存、下载过的扩展安装包和旧日志。设置、扩展与工作区不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual Studio Code 的網頁、程式碼與 GPU 快取、下載過的擴充套件安裝檔和舊日誌。設定、擴充套件與工作區不受影響。"
          }
        }
      }
    },
