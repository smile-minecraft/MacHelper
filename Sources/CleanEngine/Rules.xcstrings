    "rule.user.caches.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each app’s cache folder, rebuilt by the app when needed. Caches of Apple system components are not included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de caché de cada app, que la app rehace cuando hace falta. No incluye las cachés de los componentes del sistema de Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各 App のキャッシュフォルダで、必要なときに App が作り直します。Apple のシステムコンポーネントのキャッシュは含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 앱의 캐시 폴더로, 필요할 때 앱이 다시 만듭니다. Apple 시스템 구성 요소의 캐시는 포함하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各 App 的缓存文件夹，App 需要时会重建。Apple 系统组件的缓存不在此列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各 App 的快取資料夾，App 需要時會重建。Apple 系統元件的快取不在此列。"
          }
        }
      }
    },
    "rule.user.caches.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App caches"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés de apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App のキャッシュ"
          }
