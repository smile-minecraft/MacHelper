    "rule.browser.arc-service-worker.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline caches that websites store through service workers. Sites download them again; pages that work offline need a connection the first time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés sin conexión que guardan los sitios web mediante service workers. Los sitios las vuelven a descargar; las páginas que funcionan sin conexión necesitarán conexión la primera vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web サイトが Service Worker 経由で保存するオフライン用キャッシュ。サイトが再ダウンロードします。オフラインで動くページは、最初の 1 回だけ接続が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트가 서비스 워커로 저장하는 오프라인 캐시. 사이트가 다시 내려받으며, 오프라인으로 작동하는 페이지는 처음 한 번 연결이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站透过 Service Worker 存的脱机缓存，网站会重新下载；可脱机使用的网页第一次需要连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網站透過 Service Worker 存的離線快取，網站會重新下載；可離線使用的網頁第一次需要連線。"
          }
        }
      }
    },
