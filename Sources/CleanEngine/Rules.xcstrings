    "rule.xcode.xctestdevices.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator clones Xcode creates for parallel testing, created again on the next parallel test run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clones de simuladores que crea Xcode para pruebas en paralelo; se vuelven a crear en la siguiente ejecución en paralelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並列テスト用に Xcode が作るシミュレータのクローンで、次の並列テストで再び作られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode가 병렬 테스트용으로 만드는 시뮬레이터 복제본으로, 다음 병렬 테스트 때 다시 만들어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 平行测试时创建的模拟器复本，下次平行测试会重新创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 平行測試時建立的模擬器複本，下次平行測試會重新建立。"
          }
        }
      }
    },
