    "rule.shell.zsh-cache.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh’s completion and plug-in cache, regenerated the next time a shell starts (that start is a little slower)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de autocompletado y plug-ins de Oh My Zsh; se regenera la próxima vez que se abre una shell (ese arranque es algo más lento)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh の補完とプラグインのキャッシュで、次にシェルを起動したときに作り直されます（その起動は少し遅くなります）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh의 자동 완성 및 플러그인 캐시로, 다음에 셸을 시작할 때 다시 만들어집니다(그때는 조금 느려집니다)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh 的补全与插件缓存，下次打开 shell 时重新产生（那次启动会稍慢）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh 的補全與外掛快取，下次開啟 shell 時重新產生（那次啟動會稍慢）。"
          }
        }
      }
    },
    "rule.shell.zsh-cache.title": {
