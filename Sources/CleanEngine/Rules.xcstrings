    "rule.ai.omlx-cache.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved prompt state that speeds up repeated requests. It is rebuilt as you use oMLX; models are not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado guardado de los prompts que acelera las peticiones repetidas. Se rehace al usar oMLX; los modelos no se tocan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しのリクエストを速くするために保存されたプロンプトの状態です。oMLX を使うと作り直され、モデルには触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 요청을 빠르게 하려고 저장한 프롬프트 상태입니다. oMLX를 사용하면 다시 만들어지며 모델은 건드리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加快重复请求的提示状态缓存，使用 oMLX 时会重新创建；不会动到模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加快重複請求的提示狀態快取，使用 oMLX 時會重新建立；不會動到模型。"
          }
        }
      }
    },
    "rule.ai.omlx-cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
