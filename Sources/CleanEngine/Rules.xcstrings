    "rule.dev.pnpm.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm’s metadata cache. The package store is not included; use pnpm store prune for that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de metadatos de pnpm. No incluye el almacén de paquetes; para eso usa pnpm store prune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm のメタデータキャッシュ。パッケージストアは含みません（それには pnpm store prune を使います）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm 메타데이터 캐시. 패키지 저장소는 포함하지 않으며, 그것은 pnpm store prune을 사용하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm 的中继数据缓存。套件存放区（store）不在此列，请用 pnpm store prune。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm 的中繼資料快取。套件存放區（store）不在此列，請用 pnpm store prune。"
          }
        }
      }
    },
