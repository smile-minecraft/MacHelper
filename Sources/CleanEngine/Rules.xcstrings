    "rule.browser.safari.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web cache, downloaded again as you browse. Bookmarks, history and sign-ins are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché web que se vuelve a descargar al navegar. No afecta a los marcadores, el historial ni los inicios de sesión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web キャッシュで、閲覧すると再ダウンロードされます。ブックマーク、履歴、サインインには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 캐시로, 탐색하면 다시 내려받습니다. 북마크, 방문 기록, 로그인에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页缓存，下次浏览时会重新下载。不影响书签、历史记录与登录状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁快取，下次瀏覽時會重新下載。不影響書籤、歷史紀錄與登入狀態。"
          }
        }
      }
    },
