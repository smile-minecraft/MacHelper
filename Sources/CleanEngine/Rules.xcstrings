          }
        }
      }
    },
    "rule.user.logs.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs and DiagnosticReports written by apps. MacHelper’s own operation log is never removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros y DiagnosticReports que escriben las apps. Nunca se elimina el registro de operaciones de MacHelper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App が書き出したログと DiagnosticReports。MacHelper 自身の操作ログは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 남긴 로그와 DiagnosticReports. MacHelper의 작업 기록은 절대 제거되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 写下的日志与 DiagnosticReports。MacHelper 自己的操作记录不会被清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 寫下的日誌與 DiagnosticReports。MacHelper 自己的操作紀錄不會被清除。"
          }
        }
      }
    },
    "rule.user.logs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App logs and crash reports"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros e informes de fallos de apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App のログとクラッシュレポート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 로그 및 충돌 보고서"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
