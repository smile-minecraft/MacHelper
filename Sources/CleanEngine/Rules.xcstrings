    "rule.xcode.archives.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives of old builds. Without them you can’t symbolicate crash reports from those versions, so make sure you no longer need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de compilaciones antiguas. Sin ellos no puedes simbolizar informes de fallos de esas versiones, así que asegúrate de que ya no los necesitas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いビルドのアーカイブ。これがないとそのバージョンのクラッシュレポートをシンボル化できないので、もう必要ないことを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 빌드의 아카이브. 없으면 해당 버전의 충돌 보고서를 기호화할 수 없으므로 더 이상 필요 없는지 확인하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版本的封存盘。删除后就无法用它来符号化旧版的当机报告，请确认不再需要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版本的封存檔。刪除後就無法用它來符號化舊版的當機報告，請確認不再需要。"
          }
        }
      }
    },
    "rule.xcode.archives.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Archives (older than 180 days)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de Xcode (más de 180 días)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode のアーカイブ（180 日より古いもの）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 아카이브(180일 경과)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Archives（超过 180 天）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Archives（超過 180 天）"
          }
        }
      }
    },
    "rule.xcode.derived-data.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate build products and indexes, regenerated on the next build (which is slower the first time)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Productos intermedios de compilación e índices; se regeneran en la siguiente compilación (que la primera vez es más lenta)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中間ビルド成果物とインデックスで、次のビルドで作り直されます（最初は遅くなります）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중간 빌드 산출물과 색인으로, 다음 빌드에서 다시 만들어집니다(처음에는 느림)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建置中间产物与索引。下次建置会重新产生（第一次会比较慢）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置中間產物與索引。下次建置會重新產生（第一次會比較慢）。"
          }
        }
      }
    },
    "rule.xcode.derived-data.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode DerivedData"
          }
        }
      }
    },
    "rule.xcode.device-support.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbols downloaded when debugging on a device. Versions unused for 30 days are downloaded again the next time you connect such a device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolos descargados al depurar en un dispositivo. Las versiones sin usar en 30 días se vuelven a descargar la próxima vez que conectes ese dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスでデバッグするときにダウンロードされたシンボル。30 日使われていないバージョンは、そのデバイスを次に接続したときに再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 디버깅할 때 내려받은 기호. 30일 동안 쓰지 않은 버전은 해당 기기를 다음에 연결할 때 다시 내려받습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接实机调试时下载的符号档。超过 30 天未用的版本，下次接上该版本设备时会重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接實機除錯時下載的符號檔。超過 30 天未用的版本，下次接上該版本裝置時會重新下載。"
          }
        }
      }
    },
    "rule.xcode.device-support.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device support files (iOS / watchOS / tvOS DeviceSupport)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de soporte de dispositivos (iOS / watchOS / tvOS DeviceSupport)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
