          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros del servidor de LM Studio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio のサーバログ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio 서버 로그"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio 服务器日志文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio 伺服器記錄檔"
          }
        }
      }
    },
    "rule.ai.ollama-logs.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotated server logs (server-1.log and older). The current log and models are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros rotados del servidor (server-1.log y anteriores). Se conservan el registro actual y los modelos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローテーション済みのサーバログ（server-1.log とそれ以前）。現在のログとモデルは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순환된 서버 로그(server-1.log 및 이전). 현재 로그와 모델은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮替下来的服务器日志文件（server-1.log 及更旧的）。目前的日志文件和模型都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輪替下來的伺服器記錄檔（server-1.log 及更舊的）。目前的記錄檔和模型都會保留。"
          }
        }
      }
    },
