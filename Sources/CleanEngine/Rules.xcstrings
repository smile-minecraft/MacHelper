        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前日までのローテーション済みのサーバログ。現在のログとモデルは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 날짜의 순환된 서버 로그. 현재 로그와 모델은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前几天轮替下来的服务器日志文件。目前的日志文件和模型都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前幾天輪替下來的伺服器記錄檔。目前的記錄檔和模型都會保留。"
          }
        }
      }
    },
