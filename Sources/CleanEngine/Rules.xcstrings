    "rule.user.old-downloads.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the list first: there may be files here you want to keep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa primero la lista: puede haber archivos que quieras conservar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に一覧を確認してください。残したいファイルがあるかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 목록을 확인하십시오. 보관하고 싶은 파일이 있을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认清单：这里可能有你想保留的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認清單：這裡可能有你想保留的檔案。"
          }
        }
      }
    },
    "rule.user.old-downloads.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in Downloads older than 90 days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de Descargas con más de 90 días"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロード」内の 90 日より古いファイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 폴더에서 90일이 지난 파일"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「下载」里超过 90 天的文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下載」裡超過 90 天的檔案"
          }
        }
      }
    },
    "rule.user.trash.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes the items in the Trash. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de forma permanente los elementos de la Papelera. No se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱の中身を完全に削除します。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통의 항목을 영구적으로 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除废纸篓里的项目，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除垃圾桶裡的項目，無法復原。"
          }
        }
      }
    },
    "rule.user.trash.title": {
      "extractionState": "manual",
      "localizations": {
