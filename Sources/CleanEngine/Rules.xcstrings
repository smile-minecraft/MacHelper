    "rule.user.installers.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG, PKG, XIP and ISO installers, usually no longer needed once the app is installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores DMG, PKG, XIP e ISO, que normalmente ya no hacen falta una vez instalada la app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG、PKG、XIP、ISO のインストーラ。App をインストールしたあとは通常不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG, PKG, XIP, ISO 설치 프로그램. 앱을 설치한 후에는 보통 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG、PKG、XIP、ISO 安装包。App 安装完后通常就不需要了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG、PKG、XIP、ISO 安裝檔。App 安裝完後通常就不需要了。"
          }
        }
      }
    },
    "rule.user.installers.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installers in Downloads"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores en Descargas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロード」内のインストーラ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 폴더의 설치 프로그램"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「下载」里的安装包"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下載」裡的安裝檔"
          }
        }
      }
    },
    "rule.user.ios-backups.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local device backups made by Finder. Make sure you have another backup (such as iCloud) before deleting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias de seguridad locales de dispositivos hechas con el Finder. Asegúrate de tener otra copia (por ejemplo, en iCloud) antes de eliminarlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder が作成したデバイスのローカルバックアップ。削除する前に、別のバックアップ（iCloud など）があることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder가 만든 기기의 로컬 백업. 삭제하기 전에 다른 백업(iCloud 등)이 있는지 확인하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 创建的本地设备备份。删除前请确认你有其他备份（例如 iCloud）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 建立的本機裝置備份。刪除前請確認你有其他備份（例如 iCloud）。"
          }
        }
      }
    },
    "rule.user.ios-backups.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone / iPad backups"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias de seguridad de iPhone / iPad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone / iPad のバックアップ"
          }
        },
        "ko": {
          "stringUnit": {
