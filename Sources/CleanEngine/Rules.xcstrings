    "rule.ai.lmstudio-cache.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web and graphics caches of the LM Studio window, rebuilt when it opens. Models and chats are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés web y gráficas de la ventana de LM Studio, que se rehacen al abrirla. Se conservan los modelos y los chats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio のウインドウの Web とグラフィックのキャッシュで、開くと作り直されます。モデルとチャットは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio 윈도우의 웹 및 그래픽 캐시로, 열면 다시 만들어집니다. 모델과 채팅은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio 窗口的网页与绘图缓存，打开时会重新创建。模型和对话都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio 視窗的網頁與繪圖快取，開啟時會重新建立。模型和對話都會保留。"
          }
        }
      }
    },
    "rule.ai.lmstudio-cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio app cache"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de la app LM Studio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio の App キャッシュ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio 앱 캐시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio App 缓存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio App 快取"
          }
        }
      }
    },
    "rule.ai.lmstudio-logs.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local server logs older than a week. Models and chats are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros del servidor local de hace más de una semana. Se conservan los modelos y los chats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 週間より古いローカルサーバのログ。モデルとチャットは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1주가 지난 로컬 서버 로그. 모델과 채팅은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过一周的本地服务器日志文件。模型和对话都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過一週的本機伺服器記錄檔。模型和對話都會保留。"
          }
        }
      }
    },
    "rule.ai.lmstudio-logs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
