      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載過的套件來源，需要時會重新下載。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded package sources, downloaded again when needed."
          }
        }
      }
    },
    "rule.dev.swiftpm.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift Package Manager 快取"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift Package Manager cache"
          }
        }
      }
    },
    "rule.dev.vscode.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual Studio Code’s web, code and GPU caches, downloaded extension packages and old logs. Settings, extensions and workspaces are not affected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual Studio Code 的網頁、程式碼與 GPU 快取、下載過的擴充套件安裝檔和舊日誌。設定、擴充套件與工作區不受影響。"
          }
        }
      }
    },
    "rule.dev.vscode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code caches and logs"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VS Code 快取與日誌"
          }
        }
      }
    },
    "rule.dev.yarn.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarn 的套件快取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarn’s package cache."
          }
        }
      }
    },
    "rule.dev.yarn.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarn 快取"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarn cache"
          }
        }
      }
    },
    "rule.shell.zsh-cache.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh’s completion and plug-in cache, regenerated the next time a shell starts (that start is a little slower)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh 的補全與外掛快取，下次開啟 shell 時重新產生（那次啟動會稍慢）。"
          }
        }
      }
    },
    "rule.shell.zsh-cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh cache"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh My Zsh 快取"
          }
        }
      }
    },
    "rule.simulator.caches.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreSimulator 的動態快取，不影響模擬器裡的 App 與資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreSimulator’s dynamic caches. Apps and data inside simulators are not affected."
          }
        }
      }
    },
    "rule.simulator.caches.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器快取"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator caches"
          }
        }
      }
    },
    "rule.user.caches.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各 App 的快取資料夾，App 需要時會重建。Apple 系統元件的快取不在此列。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each app’s cache folder, rebuilt by the app when needed. Caches of Apple system components are not included."
          }
        }
      }
    },
    "rule.user.caches.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 快取"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App caches"
          }
        }
      }
    },
    "rule.user.installers.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG、PKG、XIP、ISO 安裝檔。App 安裝完後通常就不需要了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG, PKG, XIP and ISO installers, usually no longer needed once the app is installed."
          }
        }
      }
    },
    "rule.user.installers.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下載」裡的安裝檔"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installers in Downloads"
          }
        }
      }
    },
    "rule.user.ios-backups.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 建立的本機裝置備份。刪除前請確認你有其他備份（例如 iCloud）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local device backups made by Finder. Make sure you have another backup (such as iCloud) before deleting."
          }
        }
      }
    },
    "rule.user.ios-backups.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone / iPad 備份"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone / iPad backups"
          }
        }
      }
    },
    "rule.user.logs.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 寫下的日誌與 DiagnosticReports。MacHelper 自己的操作紀錄不會被清除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs and DiagnosticReports written by apps. MacHelper’s own operation log is never removed."
          }
        }
      }
    },
    "rule.user.logs.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 日誌與當機報告"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App logs and crash reports"
          }
        }
      }
    },
    "rule.user.mail-downloads.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「郵件」打開過的附件副本，原始郵件不受影響。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies of attachments opened in Mail. The original messages are not affected."
          }
        }
      }
    },
    "rule.user.mail-downloads.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "郵件附件下載"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail attachment downloads"
          }
        }
      }
    },
    "rule.user.old-downloads.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認清單：這裡可能有你想保留的檔案。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the list first: there may be files here you want to keep."
          }
        }
      }
    },
    "rule.user.old-downloads.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下載」裡超過 90 天的檔案"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in Downloads older than 90 days"
          }
        }
      }
    },
    "rule.user.trash.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除垃圾桶裡的項目，無法復原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes the items in the Trash. This can’t be undone."
          }
        }
      }
    },
    "rule.user.trash.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash"
          }
        }
      }
    },
    "rule.xcode.archives.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版本的封存檔。刪除後就無法用它來符號化舊版的當機報告，請確認不再需要。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives of old builds. Without them you can’t symbolicate crash reports from those versions, so make sure you no longer need them."
          }
        }
      }
    },
    "rule.xcode.archives.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Archives（超過 180 天）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Archives (older than 180 days)"
          }
        }
      }
    },
    "rule.xcode.derived-data.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置中間產物與索引。下次建置會重新產生（第一次會比較慢）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate build products and indexes, regenerated on the next build (which is slower the first time)."
          }
        }
      }
    },
    "rule.xcode.derived-data.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode DerivedData"
          }
        }
      }
    },
    "rule.xcode.device-support.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接實機除錯時下載的符號檔。超過 30 天未用的版本，下次接上該版本裝置時會重新下載。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbols downloaded when debugging on a device. Versions unused for 30 days are downloaded again the next time you connect such a device."
          }
        }
      }
    },
    "rule.xcode.device-support.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置支援檔（iOS / watchOS / tvOS DeviceSupport）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device support files (iOS / watchOS / tvOS DeviceSupport)"
          }
        }
      }
    },
    "rule.xcode.previews.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Previews 的模擬環境，需要時會重建。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulated environments for Xcode Previews, rebuilt when needed."
          }
        }
      }
    },
    "rule.xcode.previews.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftUI 預覽快取"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftUI previews cache"
          }
        }
      }
    },
    "rule.xcode.xctestdevices.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator clones Xcode creates for parallel testing, created again on the next parallel test run."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 平行測試時建立的模擬器複本，下次平行測試會重新建立。"
          }
        }
      }
    },
    "rule.xcode.xctestdevices.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XCTest devices"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "XCTest 測試裝置"
          }
        }
      }
    }
  }
}