    "rule.dev.opencode.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "npm packages OpenCode downloads for its plug-ins and providers, downloaded again when needed. The OpenCode program itself is not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes npm que descarga OpenCode para sus plug-ins y proveedores; se vuelven a descargar cuando hace falta. No afecta al programa OpenCode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode がプラグインやプロバイダ用にダウンロードする npm パッケージで、必要なときに再ダウンロードされます。OpenCode 本体には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode가 플러그인과 공급자용으로 내려받는 npm 패키지로, 필요할 때 다시 내려받습니다. OpenCode 프로그램 자체에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode 为插件与模型供应商下载的 npm 套件，需要时会重新下载。OpenCode 程序本身不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode 為外掛與模型供應商下載的 npm 套件，需要時會重新下載。OpenCode 程式本身不受影響。"
          }
        }
      }
    },
