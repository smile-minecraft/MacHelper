            "value": "App 日誌與當機報告"
          }
        }
      }
    },
    "rule.user.mail-downloads.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies of attachments opened in Mail. The original messages are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias de los adjuntos abiertos en Mail. No afecta a los mensajes originales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールで開いた添付ファイルのコピー。元のメッセージには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail에서 연 첨부 파일의 사본. 원본 메시지에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从「邮件」打开过的附件副本，原始邮件不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「郵件」打開過的附件副本，原始郵件不受影響。"
          }
        }
      }
    },
    "rule.user.mail-downloads.title": {
