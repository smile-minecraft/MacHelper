          }
        }
      }
    },
    "rule.xcode.previews.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulated environments for Xcode Previews, rebuilt when needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entornos simulados para las previsualizaciones de Xcode; se rehacen cuando hace falta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode プレビュー用のシミュレーション環境で、必要なときに作り直されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 미리 보기용 시뮬레이션 환경으로, 필요할 때 다시 만들어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Previews 的模拟环境，需要时会重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Previews 的模擬環境，需要時會重建。"
          }
        }
      }
    },
    "rule.xcode.previews.title": {
      "extractionState": "manual",
      "localizations": {
