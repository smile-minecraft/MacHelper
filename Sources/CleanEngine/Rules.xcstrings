    "rule.simulator.caches.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreSimulator’s dynamic caches. Apps and data inside simulators are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés dinámicas de CoreSimulator. No afecta a las apps ni a los datos de los simuladores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreSimulator の動的キャッシュ。シミュレータ内の App とデータには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreSimulator의 동적 캐시. 시뮬레이터 안의 앱과 데이터에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreSimulator 的动态缓存，不影响模拟器里的 App 与数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreSimulator 的動態快取，不影響模擬器裡的 App 與資料。"
          }
        }
      }
    },
    "rule.simulator.caches.title": {
      "extractionState": "manual",
      "localizations": {
