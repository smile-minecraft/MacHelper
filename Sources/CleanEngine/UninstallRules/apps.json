{
  "schemaVersion": 1,
  "_comment": "Per-app rules for data that follows no naming convention. include/exclude are globs (~ allowed). independentCLIs: dot-folders that belong to a separately installed command-line tool sharing an app's name (Mole #993), never removed with the app.",
  "independentCLIs": ["claude", "codex", "gemini", "opencode", "cursor", "ollama", "warp", "zed", "copilot"],
  "apps": [
    { "bundleID": "com.microsoft.VSCode",
      "include": ["~/.vscode", "~/Library/Application Support/Code", "~/Library/Caches/com.microsoft.VSCode.ShipIt"] },
    { "bundleID": "com.microsoft.VSCodeInsiders",
      "include": ["~/.vscode-insiders", "~/Library/Application Support/Code - Insiders", "~/Library/Caches/com.microsoft.VSCodeInsiders.ShipIt"] },
    { "bundleID": "com.vscodium",
      "include": ["~/.vscode-oss", "~/Library/Application Support/VSCodium"] },
    { "bundleID": "com.todesktop.230313mzl4w4u92",
      "include": ["~/Library/Application Support/Cursor"],
      "exclude": ["~/.cursor"] },
    { "bundleID": "com.anthropic.claudefordesktop",
      "include": ["~/Library/Application Support/Claude-3p", "~/Library/Logs/Claude-3p"],
      "exclude": ["~/.claude", "~/.local/share/claude", "~/.config/claude", "~/.claude.json"] },
    { "bundleID": "com.openai.codex",
      "exclude": ["~/.codex"] },
    { "bundleID": "com.docker.docker",
      "include": ["~/Library/Containers/com.docker.docker", "~/Library/Group Containers/group.com.docker"],
      "exclude": ["~/.docker"] },
    { "bundleID": "net.ankiweb.launcher",
      "include": ["~/Library/Application Support/AnkiProgramFiles", "~/Library/Preferences/net.ankiweb.dtop.plist", "~/Library/Preferences/net.ankiweb.anki.plist", "~/Library/Saved Application State/net.ankiweb.dtop.savedState"] },
    { "bundleID": "net.ankiweb.dtop",
      "include": ["~/Library/Application Support/AnkiProgramFiles"] },
    { "bundleID": "dev.zed.Zed",
      "include": ["~/.config/zed", "~/.local/state/zed", "~/Library/Application Support/Zed"] },
    { "bundleID": "com.electron.ollama",
      "exclude": ["~/.ollama"] },
    { "bundleID": "com.mitchellh.ghostty",
      "include": ["~/.config/ghostty", "~/Library/Application Support/com.mitchellh.ghostty"] },
    { "bundleID": "com.github.wez.wezterm",
      "include": ["~/.config/wezterm"] },
    { "bundleID": "org.alacritty",
      "include": ["~/.config/alacritty"] },
    { "bundleID": "com.raycast.macos",
      "include": ["~/.config/raycast", "~/Library/Containers/com.raycast.macos.BrowserExtension", "~/Library/Containers/com.raycast.macos.RaycastAppIntents"] }
  ]
}
